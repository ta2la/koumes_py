# KOUMES - C++ as canonical source (APPS/AI_T2LS/); find Python equivalent per item
# scope: C++ item (Class::member, Namespace::fn, CMD:name, MACRO)
# cpp: relative path from cvz root + line
# py: filename:line in Python port (empty if missing)
# status: empty=unchecked, ok=verified match, issue=diff (viz note), dead=C++ dead code / not-needed, cpp_specific=Qt/C++ runtime mechanismus v py bezpředmětný, new_py_feature=Python-side záměrné rozšíření nad C++ (feature co C++ nemá, nebo Python-only fix Qt-specific problému)

type: viewer
name: checks

