    at ho agent i editor vezmou jako jeden kus textu, ne jako napsane klavesy."""
    try:
        text = subprocess.run(["xclip", "-o", "-selection", "clipboard"], capture_output=True,
                              timeout=3).stdout
    except (OSError, subprocess.SubprocessError):
        text = b""
    if not text:
        say("schránka je prázdná")
        return
    subprocess.run(["tmux", "-L", SOCK, "load-buffer", "-b", "clmon4paste", "-"], input=text,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    tmux("paste-buffer", "-p", "-d", "-b", "clmon4paste", "-t", pane)


