        cmd = "%s %s" % (shlex.quote(VIEWER), shlex.quote(path))
    else:
        cmd = "%s --view %s" % (shlex.quote(ME), shlex.quote(path or ""))
    return cmd + (" --line %d" % line if line > 0 else "")


def split_lines(path):
    """`soubor:25` nebo `soubor:25:40` -> (soubor, 25, 40). Bez cisel (soubor, 0, 0)."""
    m = re.fullmatch(r"(.+?):(\d+)(?::(\d+))?", path or "")
    if m and not os.path.exists(path):
        a = int(m.group(2))
        return m.group(1), a, int(m.group(3) or 0)
    return path, 0, 0


def hx_select(pane_id, first, last):
    """V helixu, ktery se prave otevrel na radku `first`, vybrat radky first..last
    (pocet + x). Pocka, az helix nabehne (ve stavovem radku je rezim NOR)."""
    for _ in range(40):
        time.sleep(0.1)
        if " NOR " in tmux("capture-pane", "-p", "-t", pane_id)[1]:
            break
    else:
        return
    n = last - first + 1
    if n > 1:
        tmux("send-keys", "-t", pane_id, "-l", "%dx" % n)
    else:
        tmux("send-keys", "-t", pane_id, "x")


def tp(n, path, line=0, edit=False, run="", hx=False, last=0):
    """Pro agenty: ukazat soubor v panelu pN, pripadne rovnou na radku.
    edit=True ho otevre v editoru (micro), hx=True v helixu (last = vybrat radky
    line..last), run = misto souboru pustit v panelu program."""
    L = lay()
    p = panel(L, n) if n else None
    if p and p["lock"]:
        n = unlocked_right(L, p["x"])                 # zamceny panel: obsah do dalsiho
    if run:
        if not n:
            n = free_slot(L)
        port = 0
        if run_prog(run) in WS_RUN and "--port" not in run:
            port = panel_port(L, n)                   # jednotny protokol: prvni volny port
            run = "%s --port %d" % (run, port)
        err, n = open_panel(n, "run", run, "", run)
        p = panel(lay(), n)
        if p and not err:
            popt(p["id"], "@port", str(port) if port else "")
        return err
    if virtual(path):
        return open_panel(n, "view", view_cmd(path), path)[0]
    path = os.path.abspath(os.path.expanduser(path))
    if hx:
        if not shutil.which(HX):
            return "chybí editor %s" % HX
        if not os.path.exists(path):
            return "soubor není: %s" % path
        err, n = open_panel(n, "hx", hx_cmd(path, line), path)
        if not err:
            p = panel(lay(), n)
            if p:
                popt(p["id"], "@title", "%s · helix · i psát · Esc · :w uložit · :q zavřít"
                     % short(path))
                if line > 0:
                    hx_select(p["id"], line, max(line, last))
        return err
    if edit:
        if not shutil.which(EDITOR):
            return "chybí editor %s" % EDITOR
        err, n = open_panel(n, "edit", edit_cmd(path, line), path)
        if not err:
            p = panel(lay(), n)
            if p:
                popt(p["id"], "@title", "%s · editor · Ctrl+S uložit · Ctrl+Q zavřít · "
                     "označené myší je hned ve schránce · Alt+C kopíruje" % short(path))
                tmux("select-pane", "-t", p["id"])
        return err
    if not os.path.exists(path):
        return "soubor není: %s" % path
    return open_panel(n, "view", view_cmd(path, line), path)[0]


def refresh_panel(p):
    """Tlacitko [refresh]: obnovit obsah panelu podle REFRESH (klavesy do panelu)."""
    keys = refresh_keys(p)
    if not keys:
        return None
    if p["role"] == "hx":
        status = tmux("capture-pane", "-p", "-t", p["id"])[1].splitlines()
        if any("[+]" in line for line in status[-3:]):
            return "p%d: helix má neuložené změny - nejdřív ulož (:w), pak [refresh]" % p["slot"]
    for k in keys:
        if k.startswith("-l"):
            tmux("send-keys", "-t", p["id"], "-l", k[2:])
        else:
            tmux("send-keys", "-t", p["id"], k)
        time.sleep(0.15)                          # Esc a dalsi klavesa zvlast, jinak z nich je Alt+
    return None


def sh_dir(p):
    """Kde ma konzole v panelu p zacit: adresar toho, co panel ukazuje, jinak domov."""
    path = os.path.expanduser(panel_shows(p) or "") if p and p["role"] != "chat" else ""
    if path and not os.path.isdir(path):
        path = os.path.dirname(path)
    return path if path and os.path.isdir(path) else HOME


def toggle_sh(n, p):
    """[>_]: z panelu pN udelat konzoli (bash v adresari toho, co ukazoval); na konzoli
    znovu = vratit puvodni obsah (soubor, helix nebo program), stejne jako u pindani."""
    if p and p["role"] == "sh":
        prev = tmux("show-options", "-pqv", "-t", p["id"], "@prev")[1]
        if p["run"] and prev in ("run", "chat", ""):
            return open_panel(n, "run", p["run"], run=p["run"])[0]
        if prev == "hx" and p["file"]:
            return tp(n, p["file"], hx=True)
        if prev == "chat":
            return open_panel(n, "chat", chat_cmd(), run="")[0]
        return open_panel(n, "view", view_cmd(p["file"]), p["file"])[0]
    d = sh_dir(p)
    if p:
        popt(p["id"], "@prev", p["role"])
    return open_panel(n, "sh", "cd %s && exec bash -l" % shlex.quote(d),
                      run=p["run"] if p else "")[0]


def show_dir(p):
    """[← dir]: adresar souboru z panelu p ukazat v prohlizeci adresaru v panelu p1 (vzdy p1),
    soubor vybrany. Bezi-li v p1 prohlizec adresaru, skoci v nem; jinak se do p1 pusti."""
    if not p or not p["file"]:
        return None
    path = p["file"]
    q = panel(lay(), 1)
    if q and q["role"] == "run" and q["port"] and run_prog(q["run"]) == os.path.basename(DIR_VIEWER):
        arg = '"%s"' % path if " " in path else path     # cmd_sys bere "uvozovky", ne 'apostrofy'
        if "ERROR" not in panel_ask(q, "chroma_setdir %s" % arg):
            return None
    # p1 neni prohlizec adresaru (nebo neodpovida): pustit ho tam - i do zamceneho, p1 je jeho
    port = panel_port(lay(), 1)
    run = "%s %s --port %d" % (shlex.quote(DIR_VIEWER), shlex.quote(path), port)
    err, n = open_panel(1, "run", run, "", run)
    q = panel(lay(), 1)
    if q and not err:
        popt(q["id"], "@port", str(port))
    return err


def panel_port(L, n):
    """Port pro program v panelu pN: ten, ktery panel uz ma (jeho program se nahradi),
    jinak prvni volny od PANEL_PORT + 1. Podle cisla panelu ne - panely se daji prohodit
    ([<] [>]) a program si svuj port bere s sebou; skutecny port ukaze --where / --port."""
    p = panel(L, n) if n else None
    if p and p["port"]:
        return p["port"]
    used = {q["port"] for q in L["panels"] if q["port"]}
    port = PANEL_PORT + 1
    while port in used or port_busy(port):
        port += 1
    return port


def move_panel(n, d):
    """[<] / [>]: prohodit obsah panelu pN se sousedem vlevo (d = -1) nebo vpravo (+1).
    Prohodi se jen terminaly s obsahem; listy a stitky zustanou na miste a poznaji panel
    podle polohy. Cisla panelu jdou dal zleva doprava, program si bere svuj port s sebou."""
    L = lay()
    cols = L["panels"]
    i = next((k for k, p in enumerate(cols) if p["slot"] == n), -1)
    j = i + d
    if i < 0 or not 0 <= j < len(cols):
        return None
    a, b = cols[i], cols[j]
    touch()
    tmux("swap-pane", "-d", "-s", a["id"], "-t", b["id"])
    popt(a["id"], "@slot", str(b["slot"]))
    popt(b["id"], "@slot", str(a["slot"]))
    touch()
    return None


def unlocked_right(L, x):
    """Cislo nejblizsiho nezamceneho panelu napravo od sloupce x; 0 = zadny, zalozit novy."""
    right = [p for p in L["panels"] if p["x"] > x and not p["lock"]]
    return min(right, key=lambda p: p["x"])["slot"] if right else 0


def open_right(pane_id, path, view=False):
    """Soubor do panelu vpravo od panelu pane_id (nejblizsi napravo); kdyz vpravo zadny
    neni, otevre se novy - pridava se vzdy uplne vpravo. `soubor:25` otevre na radku 25
    a vybere ho, `soubor:25:40` vybere radky 25 az 40."""
    path, line, last = split_lines(path)
    L = lay()
    me = next((p for p in panes() if p["id"] == pane_id), None)
    if not me:
        return "panel %s neznám" % pane_id
    n = unlocked_right(L, me["x"])
    # text do helixu, obrazky a adresare do prohlizece; view = vse do prohlizece
    text = not view and not os.path.splitext(path)[1].lower() in IMG_EXT and os.path.isfile(path)
    return tp(n, path, line, hx=text and bool(shutil.which(HX)), last=last)


def where():
    """Pro agenty: co je prave v panelech."""
    L = lay()
    if not L["panels"]:
        print("panely: žádný")
    for p in L["panels"]:
        what = panel_shows(p) or ("program bez odpovědi" if p["role"] == "run" else "prázdný")
        if p["role"] == "run":
            what += "   [%s%s]" % (run_prog(p["run"]), ", port %d" % p["port"] if p["port"] else "")
        print("p%d: %s%s%s" % (p["slot"], what, " (editor)" if p["role"] == "edit"
                                else " (helix)" if p["role"] == "hx" else "",
                                " 🔒" if p["lock"] else ""))
    main = L["main"]
    print("agent: %s" % (main["agent"] if main and main["role"] != "idle" else "žádný"))


# Tlacitka instanci koumesu: kazde pusti svuj kod nad svym stromem. Port je pevny, stejny
# jako v config.t2l te kopie.
# Instance jsou v config.t2l, record koumes; id je jmeno tlacitka. Plni use_config.
KOUMES_CODE, KOUMES_PORTS, KOUMES_ROOTS, KOUMES_PYTHON = {}, {}, {}, {}


def port_busy(port):
    """Drzi port nekdo? Zkousi se ho zabrat, ne se na nej pripojit - pripojeni muze
    projit i na volny port, kdyz v ceste stoji proxy."""
    import socket
    with socket.socket() as s:
        try:
            s.bind(("127.0.0.1", port))
        except OSError:
            return True
    return False


def koumes_port(root):
    """Port bezici appky nad timhle stromem, jinak 0. Cte se z prikazove radky procesu."""
    for p in glob.glob("/proc/[0-9]*/cmdline"):
        try:
            args = open(p, "rb").read().split(b"\0")
        except OSError:
            continue
        if b"KOUMES.main" not in args or root.encode() not in args:
            continue
        if b"--port" in args:
            i = args.index(b"--port")
            if i + 1 < len(args) and args[i + 1].isdigit():
                return int(args[i + 1])
        return KOUMES_PORT
    return 0


_LIVE = {"t": 0.0, "v": ()}


def koumes_live():
    """Jmena tlacitek, jejichz koumes bezi - ta jsou v menu zlute. Drzi se 2 s,
    protoze menu se prekresluje kazdych 0,3 s a prohledavat /proc tak casto je zbytecne."""
    now = time.monotonic()
    if now - _LIVE["t"] > 2.0:
        _LIVE["v"] = tuple(n for n, r in KOUMES_ROOTS.items() if koumes_port(r)) \
            + (("diag",) if diag_running() else ())
        _LIVE["t"] = now
    return _LIVE["v"]


# Kam koumes patri: vpravo vedle okna terminalu, na jeho vysku; sirka mu zustava.
# Plati pri spusteni i pri kliku na uz bezici appku. Okno se posouva primo pres wmctrl.
def _wgeom(wid):
    """(x, y, w, h) vnitrku okna z X. Ne z wmctrl -lG: u gnome-terminalu vraci
    nesmyslne x (zdvojene), a okno by pak slo mimo obrazovku."""
    info = xrun("xwininfo", "-id", wid)
    vals = {}
    for key, name in (("Absolute upper-left X:", "x"), ("Absolute upper-left Y:", "y"),
                      ("Width:", "w"), ("Height:", "h")):
        m = re.search(re.escape(key) + r"\s*(-?\d+)", info)
        if not m:
            return None
        vals[name] = int(m.group(1))
    return vals["x"], vals["y"], vals["w"], vals["h"]


def _extents(wid, prop):
    """(vlevo, vpravo, nahore, dole) z vlastnosti okna, jinak nuly."""
    m = re.search(r"=\s*(\d+),\s*(\d+),\s*(\d+),\s*(\d+)", xrun("xprop", "-id", wid, prop))
    return tuple(int(v) for v in m.groups()) if m else (0, 0, 0, 0)


def _koumes_win(root):
    """Id okna koumesu nad timhle stromem: titulek je `KOUMES  <strom>`."""
    for line in xrun("wmctrl", "-l").splitlines():
        f = line.split(None, 3)
        if len(f) == 4 and f[3].split() == ["KOUMES", root]:
            return f[0]
    return ""


def koumes_place(root):
    """Postavit okno koumesu vpravo vedle terminalu na jeho vysku. Vraci hlasku, nebo None."""
    return win_place(_koumes_win(root), "koumesu")


PLACE_MARGIN = 30           # srovnane okno nekonci natesno u praveho okraje monitoru


def _monitor_at(px, py):
    """(x, y, w, h) monitoru, na kterem lezi bod, z xrandr; None, kdyz zadny."""
    for line in xrun("xrandr", "--query").splitlines():
        if " connected" not in line:
            continue
        m = re.search(r"(\d+)x(\d+)\+(\d+)\+(\d+)", line)
        if not m:
            continue
        w, h, x, y = (int(v) for v in m.groups())
        if x <= px < x + w and y <= py < y + h:
            return x, y, w, h
    return None


def win_place(win, what):
    """Postavit okno vpravo vedle terminalu na jeho vysku. Kdyz by pres pravy okraj
    monitoru s terminalem precnivalo, zuzi se. Vraci hlasku, nebo None."""
    term = our_window() or active_window()
    tg = _wgeom(term) if term else None
    kg = _wgeom(win) if win else None
    if not tg:
        return "nejde zjistit, kde je okno terminálu"
    if not kg:
        return "okno %s nenašel" % what
    tx, ty, tw, th = tg
    # Viditelna vyska: terminal (gnome-terminal) ma v okne neviditelny stin
    # (_GTK_FRAME_EXTENTS), koumesu kresli titulek spravce oken nad oknem
    # (_NET_FRAME_EXTENTS). Srovnat viditelny horni a dolni okraj.
    _, _, st, sb = _extents(term, "_GTK_FRAME_EXTENTS")
    _, _, ft, fb = _extents(win, "_NET_FRAME_EXTENTS")
    ky = ty + st + ft
    kh = max(100, ty + th - sb - fb - ky)
    want = (tx + tw, ky)
    # sirka: nevejde-li se na monitor terminalu, zuzit po jeho pravy okraj minus
    # PLACE_MARGIN (vcetne ramu)
    kw = kg[2]
    fl, fr, _, _ = _extents(win, "_NET_FRAME_EXTENTS")
    mon = _monitor_at(tx + tw - 1, ty + th // 2)
    if mon:
        room = mon[0] + mon[2] - PLACE_MARGIN - want[0] - fl - fr
        kw = max(200, min(kw, room))
    # nejdriv zuzit na miste, pak posunout: siroke okno by spravce oken pri posunu
    # k okraji odtlacil zpet na obrazovku a pak by precnivalo
    xrun("wmctrl", "-i", "-r", win, "-e", "0,-1,-1,%d,%d" % (kw, kh))
    time.sleep(0.3)
    # wmctrl stavi ram okna, xwininfo hlasi vnitrek - po prvnim posunu dorovnat o rozdil
    x, y = want
    for _ in range(2):
        xrun("wmctrl", "-i", "-r", win, "-e", "0,%d,%d,%d,%d" % (x, y, kw, kh))
        time.sleep(0.3)
        now = _wgeom(win)
        if not now or (now[0], now[1]) == want:
            break
        x, y = x + want[0] - now[0], y + want[1] - now[1]
    return None


def koumes_start(name):
    """Tlacitko: kdyz koumes nebezi, pustit ho, kdyz bezi, jen ho srovnat vedle
    terminalu. Druha kopie nad tymz stromem se nepousti."""
    root = KOUMES_ROOTS[name]
    where = name
    port = koumes_port(root)
    if port:
        return koumes_place(root) or "koumes na %s srovnán vedle terminálu" % where
    port = KOUMES_PORTS[name]
    if port_busy(port):
        return "port %d je obsazený, koumes na %s nejde pustit" % (port, where)
    try:
        subprocess.Popen([KOUMES_PYTHON[name], "-m", "KOUMES.main", root, "--port", str(port)],
                         cwd=KOUMES_CODE[name], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError as e:
        return "koumes nejde pustit: %s" % e
    # pockat, az si vezme port, a hned ho postavit tam, kam patri. Bezi to v samostatnem
    # procesu tlacitka, takze cekanim se menu nezasekne.
    for _ in range(40):
        time.sleep(0.5)
        if _koumes_win(root):
            time.sleep(1.0)
            koumes_place(root)
            break
    return "koumes na %s se spouští, port %d" % (where, port)


# Tlacitko [diag]: prohlizec diagramu (APPS/DIAG_VIEW) samostatne, mimo koumes, aby se
# po zmene kodu nemusel restartovat koumes. Okno se staví jako koumes.
DIAG_SCRIPT, DIAG_FILE, DIAG_PYTHON = "", "", ""      # config.t2l, record diag; plni use_config


def dir_start():
    """Tlacitko [dir]: prohlizec adresaru (CPPBROWSE) v p1. Kdyz v p1 uz bezi, jen do nej skocit."""
    q = panel(lay(), 1)
    if q and q["role"] == "run" and run_prog(q["run"]) == os.path.basename(DIR_VIEWER):
        tmux("select-pane", "-t", q["id"])
        return None
    return tp(1, None, run="%s %s" % (DIR_VIEWER, shlex.quote(config.tree())))


def diag_running():
    if not DIAG_SCRIPT:
        return False
    for p in glob.glob("/proc/[0-9]*/cmdline"):
        try:
            args = open(p, "rb").read().split(b"\0")
        except OSError:
            continue
        if len(args) > 1 and args[0].endswith(b"python") and DIAG_SCRIPT.encode() in args:
            return True
    return False


def _diag_win():
    """Id okna prohlizece: titulek zacina `DIAG_VIEW `."""
    for line in xrun("wmctrl", "-l").splitlines():
        f = line.split(None, 3)
        if len(f) == 4 and f[3].startswith("DIAG_VIEW "):
            return f[0]
    return ""


def diag_start():
    """Kdyz prohlizec nebezi, pustit ho; kdyz bezi, jen ho srovnat vedle terminalu."""
    if diag_running():
        return win_place(_diag_win(), "diagramu") or "diag srovnán vedle terminálu"
    try:
        subprocess.Popen([DIAG_PYTHON, "-B", DIAG_SCRIPT, DIAG_FILE], cwd="/tmp",
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError as e:
        return "diag nejde pustit: %s" % e
    for _ in range(20):
        time.sleep(0.5)
        if _diag_win():
            time.sleep(0.5)
            win_place(_diag_win(), "diagramu")
            break
    return "diag se spouští"


def toggle(name):
    """Tlacitka a klavesy: pN = otevrit panel pN (prazdny prohlizec), xN = zavrit pN,
    chatN = panel pN mezi pindanim a puvodnim obsahem, lockN = zamknout / odemknout pN,
    chat = [pindani] z menu (prvni nezamceny panel, jinak novy), pnext = dalsi panel s nejnizsim volnym cislem."""
    name = name or ""
    if name in KOUMES_ROOTS:
        return koumes_start(name)
    if name == "diag":
        return diag_start()
    if name == "dir":
        return dir_start()
    if name == "config":
        return tp(1, None, run=shlex.quote(CONFIG_VIEW))
    if name == "exit_actual":
        return exit_actual()
    if re.fullmatch(r"a\d+", name):
        return show(int(name[1:]), True, start=True)      # klik na jmeno v radku nebezicich pusti
    L = lay()
    m = re.fullmatch(r"(p|x|chat|lock|refresh|updir|copy|sh|mvl|mvr|repos|timeax|aicom|remarks|apps)(\d+)", name)
    if m:
        kind, n = m.group(1), int(m.group(2))
        if kind in ("mvl", "mvr"):
            return move_panel(n, -1 if kind == "mvl" else 1)
        p = panel(L, n)
        if kind == "copy":
            return copy_path(p)
        if kind == "refresh":
            return refresh_panel(p)
        if kind == "updir":
            return show_dir(p)
        if kind == "repos":
            return tp(n, REPOS)                   # [repos] v liste panelu: repa v tomhle panelu
        if kind == "apps":
            return tp(n, None, run=shlex.quote(APPS_VIEWER))   # [apps] v liste panelu: prehled appek
        if kind == "timeax":
            # [timeax] v liste panelu: dirview v rezimu timeaxis v tomhle panelu
            return tp(n, None, run="%s timeaxis:" % shlex.quote(DIR_VIEWER))
        if kind == "aicom":
            # [aicom] v liste panelu: dirview v rezimu aicom v tomhle panelu
            return tp(n, None, run="%s aicom:" % shlex.quote(DIR_VIEWER))
        if kind == "remarks":
            # [remarks] v liste panelu: posledni .REMARKS v appce polozky, jako polozka timeaxis
            last = subprocess.run([AICOM_TOOL, "--remarks", "find"], capture_output=True,
                                  text=True).stdout.strip()
            return tp(n, ESENCE + last) if last else "no remarks yet"
        if kind == "sh":
            return toggle_sh(n, p)
        if kind == "lock":
            if p:
                popt(p["id"], "@lock", "" if p["lock"] else "1")
            return None
        if kind == "x":
            return close_panel(n)
        if kind == "p":
            if p:                                 # otevreny panel: jen do nej skocit
                tmux("select-pane", "-t", p["id"])
                return None
            return open_panel(n, "view", view_cmd(""), "")[0]
        # pindani <-> puvodni obsah panelu (soubor, helix nebo program), panel zustava otevreny
        if p and p["role"] == "chat":
            if p["run"]:                          # pred pindanim tu bezel program - pustit ho znovu
                return open_panel(n, "run", p["run"], run=p["run"])[0]
            if tmux("show-options", "-pqv", "-t", p["id"], "@prev")[1] == "hx" and p["file"]:
                return tp(n, p["file"], hx=True)
            return open_panel(n, "view", view_cmd(p["file"]), p["file"])[0]
        if p:
            popt(p["id"], "@prev", p["role"])
        return open_panel(n, "chat", chat_cmd(), run=p["run"] if p else "")[0]
    if name == "pnext":
        return open_panel(0, "view", view_cmd(""), "")[0]
    if name == "chat":
        # [pindani] v menu: ukaze se v prvnim nezamcenem panelu zleva, jinak v novem.
        # Znovu = panel se vrati k tomu, co v nem bylo (soubor nebo program).
        p = next((p for p in L["panels"] if p["role"] == "chat"), None)
        if p:
            return toggle("chat%d" % p["slot"])
        free = [p for p in L["panels"] if not p["lock"]]
        if free:
            return toggle("chat%d" % min(free, key=lambda p: p["x"])["slot"])
        return open_panel(0, "chat", chat_cmd(), run="")[0]
    return None


# ---- prepinani agentu ------------------------------------------------------------------
def launch(idx):
    """Pustit agenta idx na pozadi, bez prepinani toho, co je dole.
    Vraci (chyba, id panelu)."""
    items = entries()
    if idx < 0 or idx >= len(items):
        return "položka %d není" % (idx + 1), None
    label, path = items[idx]
    ps = panes()
    st, sess = state_of(label, path, ps, load_agents(load_conf_names()))
    pane = pane_of(label, ps)
    if st == "jinde":
        return "%s běží mimo clmon (pid %d) - ukonči ji tam a pusť odsud" % (label, sess["pid"]), None
    if st == "here":
        if pane:
            return None, pane["id"]
        return "%s běží v clmon, ale její panel neznám" % label, None
    if not os.path.isdir(path):
        return "adresář %s není" % path, None
    if st == "shell" and pane:
        # session skoncila, v panelu zbyl bash - pustit ji v nem znovu
        wake(pane["id"])
        tmux("send-keys", "-t", pane["id"], "-l",
             "cd %s && %s" % (shlex.quote(path), agent_inner(label, path)))
        tmux("send-keys", "-t", pane["id"], "Enter")
        return None, pane["id"]
    rc, pid = tmux("new-window", "-d", "-t", "ui:", "-n", label, "-c", path,
                   "-P", "-F", "#{pane_id}", agent_cmd(label, path))
    if rc != 0 or not pid:
        return "nejde založit panel pro " + label, None
    popt(pid, "@agent", label)
    return None, pid


def free_worker():
    """Cislo polozky volneho workera s nejnizsim indexem (T1 pred T2 ...), nebo -1."""
    for i, label, path, st, _ in rows_state():
        if is_worker(path) and st in ("off", "shell"):
            return i
    return -1


def start_cli(arg):
    """Pro agenty: pustit polozku na pozadi. arg = `worker` (volny s nejnizsim cislem),
    cislo ze seznamu, nebo kus jmena. Vypise, koho pustil."""
    items = entries()
    if arg == "worker":
        idx = free_worker()
        if idx < 0:
            return "žádný worker není volný"
    elif arg.isdigit():
        idx = int(arg) - 1
    else:
        exact = [i for i, (label, _) in enumerate(items) if label.split()[-1].lower() == arg.lower()]
        hits = exact or [i for i, (label, _) in enumerate(items) if arg.lower() in label.lower()]
        if len(hits) != 1:
            return "jméno `%s` sedí na %d položek" % (arg, len(hits))
        idx = hits[0]
    err, _ = launch(idx)
    if err:
        return err
    print(items[idx][0])
    return None


def show(idx, focus=True, start=True):
    """Dat agenta idx do terminalu dole. Vraci None, nebo text, proc to neslo.
    start=False (klik mysi) jen prepina - agenta, ktery nebezi, nepusti."""
    items = entries()
    if idx < 0 or idx >= len(items):
        return None
    label, path = items[idx]
    ps = panes()
    L = lay(ps)
    if not L["list"]:
        return "seznam nebezi"
    target = pane_of(label, ps)
    if target and start:
        # po /exit zbyl v panelu bash - klik ho ma pustit znovu, ne jen ukazat shell
        st, _ = state_of(label, path, ps, load_agents(load_conf_names()))
        if st == "shell":
            err, _ = launch(idx)
            if err:
                return err
    if not target:
        if not start:
            st, sess = state_of(label, path, ps, load_agents(load_conf_names()))
            if st == "jinde":
                return "%s běží mimo clmon (pid %d) - přepnout na ni tady nejde" % (label, sess["pid"])
            return "%s neběží" % label
        err, pid = launch(idx)
        if err:
            return err
        target = {"id": pid}
    main = L["main"]
    main_id = main["id"] if main else ensure_main(L)
    if not main_id:
        return "nejde založit místo pro agenta"
    if main_id != target["id"]:
        tmux("swap-pane", "-d", "-s", target["id"], "-t", main_id)
        if not main or main["role"] == "idle":
            tmux("kill-pane", "-t", main_id)      # prazdne misto uz neni potreba
    if focus:
        wake(target["id"])
        tmux("select-pane", "-t", target["id"])
    return None


def dblclick(idx):
    """Dvojklik v seznamu: nebezici agenta pusti, bezicimu posle /exit."""
    items = entries()
    if idx < 0 or idx >= len(items):
        return None
    label, path = items[idx]
    ps = panes()
    st, sess = state_of(label, path, ps, load_agents(load_conf_names()))
    pane = pane_of(label, ps)
    if st == "jinde":
        return "%s běží mimo clmon (pid %d) - ukonči ji tam a pusť odsud" % (label, sess["pid"])
    if st == "off":
        return show(idx, True, start=True)
    if not pane:
        return "%s běží v clmon, ale její panel neznám" % label
    wake(pane["id"])
    if st == "here":
        tmux("send-keys", "-t", pane["id"], "-l", "/exit")
        tmux("send-keys", "-t", pane["id"], "Enter")
        return "%s: posláno /exit" % label
    # shell: session skoncila, v panelu zbyl bash - pustit ji v nem znovu
    tmux("send-keys", "-t", pane["id"], "-l",
         "cd %s && %s" % (shlex.quote(path), agent_inner(label, path)))
    tmux("send-keys", "-t", pane["id"], "Enter")
    return show(idx, True)


def close_all():
    """Prikaz [close]: ukoncit clmon4, ale jen kdyz v nem nebezi zadny agent. Agenty
    nezavira - kdyz nejaky bezi, jen nahore napise, koho ma uzivatel nejdriv tipnout.
    Okno terminalu se vrati na puvodni sirku a zustane v nem obycejny shell."""
    here = [label for _, label, _, st, _ in rows_state() if st == "here"]
    if here:
        say("nejdřív tipni běžící: " + ", ".join(here))
        return
    for p in lay()["panels"]:
        if not leave_editor(p["slot"]):
            say(EDIT_BUSY % p["slot"])
            return
    for p in reversed(lay()["panels"]):
        drop_panel(p)                      # zavrit panely, at se okno zuzi zpatky
    tmux("kill-server")


def exit_actual():
    """[exit actual]: zobrazenemu agentovi poslat /exit."""
    main = lay()["main"]
    label = main["agent"] if main and main["role"] != "idle" else ""
    idx = next((i for i, (lab, _) in enumerate(entries()) if lab == label), -1)
    return deactivate(idx) if label and idx >= 0 else "no agent is shown"


def icon_col(idx):
    """Sloupec kolecka stavu. Radek seznamu je: sipka (2 sloupce), cislo s mezerou, kolecko.
    Stejne ho kresli ListUi.draw."""
    return 2 + len("%d " % (idx + 1))


def on_icon(idx, x, armed=False):
    """Padl klik na kolecko stavu? Kdyz sviti stitek /exit, plati cela jeho sirka."""
    col = icon_col(idx)
    return col <= x <= col + (len(ARM_LABEL) - 1 if armed else 1)


def deactivate(idx):
    """Klik na kolecko stavu: bezicimu agentovi poslat /exit."""
    items = entries()
    if idx < 0 or idx >= len(items):
        return None
    label, path = items[idx]
    ps = panes()
    st, sess = state_of(label, path, ps, load_agents(load_conf_names()))
    pane = pane_of(label, ps)
    if st == "jinde":
        return "%s běží mimo clmon (pid %d) - ukončit ji jde jen tam" % (label, sess["pid"])
    if st != "here" or not pane:
        return None
    wake(pane["id"])
    tmux("send-keys", "-t", pane["id"], "-l", "/exit")
    tmux("send-keys", "-t", pane["id"], "Enter")
    return "%s: posláno /exit" % label


def list_click(y, x, double=False):
    """Klik v seznamu bezicich: na kolecko = ukoncit, jinde = prepnout; dvojklik = /exit."""
    idx = row_to_idx(y)
    if idx < 0:
        return None
    if on_icon(idx, x):
        return None if double else deactivate(idx)     # druhy klik dvojkliku uz nic neposila
    return dblclick(idx) if double else show(idx, True, start=False)


def number(n):
    """Cislo z klavesnice: 0 = pindani, 1-9 = agent podle poradi v seznamu."""
    return toggle("chat") if n == 0 else show(n - 1, True)


