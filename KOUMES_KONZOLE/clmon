        self.n_run = -1            # kolik agentu bezi (@busy pro menu)
        self.idle_rows = []        # nebezici pod bezicimi: [[(sloupec, text, cislo)]]
        self.gpt_limits = []       # limity Codexu (GPT) pod limity claude
        self.applied_for = None
        self.flags = None
        self.shape = None          # (sirka okna, vyska okna, co je otevrene)
        self.sizes = None          # ({cislo panelu: sirka}, vyska seznamu)
        self.code = self.code_stamp()
        if self.pane:
            popt(self.pane, "@role", "list")
        tmux("source-file", TMUX_CONF)     # zmeny v nastaveni se projevi s novym seznamem
        tmux("set-option", "-g", "set-titles-string", SOCK)   # podle titulku se pozna okno
        self.buf = b""             # nedoctena sekvence ze vstupu
        self.hover = None          # (radek, sloupec), kde je mys nad seznamem
        self.hover_t = 0.0         # kdy se tam naposled pohnula
        self.tip = -1              # radek, na kterem sviti stitek /exit
        self.last_click = (0.0, -1)
        self.winch = False
        signal.signal(signal.SIGWINCH, lambda *a: setattr(self, "winch", True))
        if not bind_keys(self.pane):
            say("clmon: klávesy a myš se nepodařilo nastavit (%s)" % KEYS_CONF)

    @staticmethod
    def code_stamp():
        try:
            return (os.path.getmtime(ME),)
        except OSError:
            return None

    def refresh_data(self):
        # zmenil se kod na disku -> skoncit; smycka v panelu pusti seznam znovu s novym.
        # Agentu dole se to netyka.
        if self.code_stamp() != self.code:
            raise SystemExit(0)
        self.conf = load_conf_names()
        self.items = entries()
        self.agents = load_agents(self.conf)
        self.log.update(self.agents, self.conf)
        self.ps = panes()
        self.rows = rows_state(self.items, self.ps, self.agents)
        # Slozene ikony (1️⃣, 🅰️) pocita curses jinak siroke nez terminal a po prekresleni
        # by za nimi zustavaly zbytky znaku. Jednou za obnovu proto prekreslit vse.
        self.scr.redrawwin()
        # hlaska v liste po par sekundach zmizi
        if gopt("@msg"):
            try:
                old = time.time() - float(gopt("@msg_t")) > MSG_SECS
            except ValueError:
                old = True
            if old:
                gopt("@msg", "")
                status_refresh()
        # seznam ma radek pro kazdeho bezicího a pod nimi nebezici; vysku drzi podle nich,
        # dokud ji uzivatel nezmeni sam
        self.idle_rows = idle_layout(self.rows, self.scr.getmaxyx()[1])
        # bezici · cara · nebezici · cara · limity · limity GPT (jen kdyz Codex nekdy bezel)
        self.gpt_limits = codex_limits()
        nvis = max(1, len(running(self.rows))) + 1 + len(self.idle_rows) + 1 + 1 \
            + (1 if self.gpt_limits else 0)
        if self.top_h == self.nvis:
            self.top_h = nvis
        self.nvis = nvis
        # nebezici jsou jen jmenem na druhem radku menu nad seznamem
        bar = idle_data(self.rows)
        if bar != self.bar:
            gopt("@idle", bar)
            self.bar = bar
        n_run = len(running(self.rows))
        if n_run != self.n_run:
            gopt("@busy", str(n_run) if n_run else "")   # menu: [close] jen kdyz nic nebezi
            self.n_run = n_run
        # Tlacitka jsou v menu nad seznamem, lista tmuxu neni potreba. Hlidat ji, protoze
        # nacteni nastaveni (source-file) by ji vratilo.
        if tmux("show-options", "-gv", "status")[1] != "off":
            tmux("set-option", "-g", "status", "off")
        L = lay(self.ps)
        if L["list"] and not L["main"]:
            # terminal agenta zmizel (agent skoncil a shell se zavrel) - dat tam prazdne misto
            ensure_main(L)
            self.ps = panes()
            L = lay(self.ps)
            self.applied_for = None
        # tlacitka v liste musi sedet s tim, co je opravdu otevrene
        flags = tuple((p["slot"], p["role"]) for p in L["panels"])
        if flags != self.flags:
            gopt("@panels", ",".join(str(p["slot"]) for p in L["panels"]))
            gopt("@chat", next((str(p["slot"]) for p in L["panels"] if p["role"] == "chat"), ""))
            self.flags = flags
        lp = L["list"]
        if not lp or lp["zoom"]:
            self.shape = None
            return
        if ensure_tbars(L) | ensure_avatar(L):
            self.ps = panes()
            L = lay(self.ps)
            lp = L["list"]
            self.applied_for = None           # vysku seznamu srovnat znovu
        # Tazeni vodorovne hrany mysi: zmenila se vyska seznamu, ale okno ani tlacitka ne -
        # hranu pretahl uzivatel. Zapamatovat, at ji priste nic nevrati na vychozi hodnotu.
        # Sirky sloupcu si pri tazeni hlida clamp() sam (vazba na MouseDrag1Border).
        shape = (lp["ww"], lp["wh"], flags, gopt("@gen"))
        sizes = self.sizes_of(L)
        if shape == self.shape and self.sizes and sizes != self.sizes:
            if L["main"] and sizes[1] != self.sizes[1]:
                self.top_h = sizes[1]
                self.applied_for = (lp["wh"], lp["ww"], self.top_h)
        # vysku seznamu a sirky panelu drzet i po zmene velikosti okna (pojistka k hooku
        # client-resized, kdyby se nespustil)
        if L["main"] and self.applied_for != (lp["wh"], lp["ww"], self.top_h):
            tmux("resize-pane", "-t", lp["id"], "-y", max(1, min(self.top_h, lp["wh"] - 6)))
            if not busy():
                fit()
            self.applied_for = (lp["wh"], lp["ww"], self.top_h)
            self.ps = panes()
            sizes = self.sizes_of(lay(self.ps))       # az po srovnani, at se nebere za tazeni
        # Tazeni hrany tmux obslouzi sam a skript pusti jen na zacatku a na konci - a ten
        # na konci jen, kdyz mys pri pusteni stoji presne na hrane. Proto i tady: dokud
        # se okno nemeni, zapamatovat sirky, jak jsou, a hlidat minimum.
        if L["panels"] and not busy():
            if getattr(self, "cols_ww", 0) == lp["ww"]:
                clamp()
            self.cols_ww = lp["ww"]
        self.shape, self.sizes = shape, sizes

    @staticmethod
    def sizes_of(L):
        widths = {p["slot"]: p["w"] for p in L["panels"]}
        widths[0] = (L["menu"] or L["list"])["w"] if L["list"] else 0   # 0 = levy sloupec
        return (widths, L["list"]["h"] if L["list"] else 0)

    def draw(self):
        scr = self.scr
        scr.erase()
        h, w = scr.getmaxyx()
        now = time.time()
        main = lay(self.ps)["main"]
        active = main["agent"] if main else ""
        vis = running(self.rows)
        # Najeti mysi na kolecko bezicího agenta: na tom radku se cerne na zlutem ukaze, co
        # klik udela. Stitek prekryva pulku ikony agenta, takze pri zmene prekreslit vse,
        # jinak po nem v terminalu zustane zbytek znaku.
        tip = -1
        if self.hover and now - self.hover_t < TIP_SECS:
            hy, hx = self.hover
            if 0 <= hy < len(vis) and vis[hy][3] == "here" \
                    and on_icon(vis[hy][0], hx, armed=(self.tip == hy)):
                tip = hy
        if tip != self.tip:
            scr.clear()
            self.tip = tip
        namew = max([cwidth(r[1]) for r in vis] + [4]) + 2
        if not vis:
            self.put(0, 2, "žádný agent neběží - klik na jméno pod tímhle řádkem ho pustí",
                     curses.A_DIM)
        for i, (idx, label, path, st, sess) in enumerate(vis[:h]):
            # zadny vyber ani zvyrazneny radek - jedina sipka ukazuje, kdo je dole
            # aktivni (ten dole): sipka zluta bez podkresu, ikona se jmenem podkreslene jako tab
            on = label == active
            yellow = self.pal.get("tab", curses.A_REVERSE)
            arrow = self.pal.get("ctx_warn", 0) | curses.A_BOLD
            x = self.put(i, 0, "▶" if on else " ", arrow if on else 0)
            x = self.put(i, x, " ", 0)
            x = self.put(i, x, "%d " % (idx + 1), curses.A_DIM)
            # bezi tady = zelena (● pracuje, ○ ceka) · bezi jinde = ⊗ · nebezi = tecka
            if st == "jinde":
                dot, dattr = "⊗ ", 0
            elif sess:
                dot, dattr = ("● " if sess["status"] == "busy" else "○ "), \
                    self.pal.get("busy", curses.A_BOLD)
            else:
                dot, dattr = "· ", curses.A_DIM
            x = self.put(i, x, dot, dattr)
            # agent, ktery neni claude (`cmd:` v projects.conf, napr. Codex/GPT), ma jmeno zlute,
            # agent na jinem PC (ssh) tmave oranzove
            gpt = (self.pal.get("remote", 0) if is_remote(path) else
                   self.pal.get("ctx_warn", 0) if conf_cmd(path) else 0)
            self.put(i, x, label, yellow if on else (gpt | curses.A_BOLD) if st == "here" else
                     (gpt | curses.A_DIM) if st == "off" else gpt)
            x += namew
            if sess:
                sattr = (self.pal.get("st_wait", curses.A_REVERSE | curses.A_BLINK)
                         if sess["status"] == "waiting" else
                         self.pal.get("st_busy", curses.A_BOLD) if sess["status"] == "busy" else 0)
                x = self.put(i, x, "%-4s" % sess["status"], sattr)
                x = self.put(i, x, " %4s  " % ago(now - sess["since"]),
                             curses.A_BOLD if sess["status"] == "busy" else 0)
                ctx, model = (codex_usage(sess["transcript"]) if sess.get("codex")
                              else self.log.usage.get(sess["transcript"], (0, "")))
                x = self.put(i, x, "%-11s " % (model.replace("claude-", "") or "?"),
                             self.pal.get("info", 0))
                cattr = (self.pal.get("ctx_high", curses.A_BOLD) if ctx >= CTX_HIGH
                         else self.pal.get("ctx_warn", curses.A_BOLD) if ctx >= CTX_WARN
                         else self.pal.get("info", 0))
                x = self.put(i, x, "%5s  " % (ktok(ctx) if ctx else "?"), cattr)
            if st == "jinde":
                self.put(i, x, "běží mimo clmon", curses.A_DIM)
            if i == self.tip:
                self.put(i, icon_col(idx), ARM_LABEL, self.pal.get("arm", curses.A_REVERSE))
        # nebezici: klik na jmeno pusti
        # tenka cara oddeluje bezici, nebezici a limity
        sepw = max(1, self.scr.getmaxyx()[1] - 1)
        top = max(1, len(vis))
        self.put(top, 0, "┈" * sepw, curses.A_DIM)
        top += 1
        for r, row in enumerate(self.idle_rows):
            for x, text, idx in row:
                self.put(top + r, x, text, curses.A_DIM if idx is None else 0)
        ly = top + len(self.idle_rows)
        self.put(ly, 0, "┈" * sepw, curses.A_DIM)
        ly += 1
        # limity uctu (5h a tyden) pod vsemi, pod nimi limity GPT (Codex); barvy jako u kontextu
        for head, parts in (("  limity: ", usage_parts() or [("?", None)]),
                            ("  limity GPT: ", self.gpt_limits)):
            if not parts:
                continue
            ux = self.put(ly, 0, head, curses.A_DIM)
            for i, (text, pct) in enumerate(parts):
                if i:
                    ux = self.put(ly, ux, "  ·  ", curses.A_DIM)
                attr = (self.pal.get("ctx_high", curses.A_BOLD) if pct is not None and pct >= 90
                        else self.pal.get("ctx_warn", curses.A_BOLD) if pct is not None and pct >= 70
                        else self.pal.get("info", 0))
                ux = self.put(ly, ux, text, attr)
            ly += 1
        scr.refresh()

    def act(self, err):
        if err:
            say(err)
        self.ps = panes()

    def step(self, d):
        """Sipka posune ▶ na dalsiho agenta, ktery uz ma svuj panel. Nic se tim
        nespousti a vstup zustava v seznamu."""
        main = lay(self.ps)["main"]
        active = main["agent"] if main else ""
        ok = [i for i, (label, _) in enumerate(self.items) if pane_of(label, self.ps)]
        if not ok:
            return
        cur = next((i for i, (label, _) in enumerate(self.items) if label == active), None)
        pos = ok.index(cur) if cur in ok else (-1 if d > 0 else 0)
        self.act(show(ok[(pos + d) % len(ok)], False))

    def events(self, timeout):
        """Vstup cte seznam sam, ne pres curses: [("key", jmeno)] a [("mouse", tlacitko, x, y,
        stisk)]. Curses pri tazeni mysi ceka na zbytek udalosti a zamrzne; tohle neblokuje."""
        try:
            r, _, _ = select.select([0], [], [], timeout)
        except (InterruptedError, OSError):
            return []
        if not r:
            return []
        data = self.buf + os.read(0, 4096)
        self.buf = b""
        out = []
        while data:
            m = RE_SGR.match(data)
            if m:
                out.append(("mouse", int(m.group(1)), int(m.group(2)) - 1, int(m.group(3)) - 1,
                            m.group(4) == b"M"))
                data = data[m.end():]
            elif data.startswith(b"\x1b[<") and len(data) < 32:
                self.buf = data            # neuplna udalost mysi - zbytek prijde priste
                break
            elif next((k for k in KEYSEQ if data.startswith(k)), None):
                k = next(k for k in KEYSEQ if data.startswith(k))
                out.append(("key", KEYSEQ[k]))
                data = data[len(k):]
            elif data[:1] == b"\x1b":
                j = 1                      # jina sekvence - zahodit celou
                if data[1:2] in (b"[", b"O"):
                    j = 2
                    while j < len(data) and not 0x40 <= data[j] <= 0x7e:
                        j += 1
                    j += 1
                data = data[j:]
            else:
                out.append(("key", data[:1].decode("latin-1")))
                data = data[1:]
        return out

    def on_mouse(self, b, x, y, pressed):
        vis = running(self.rows)
        if b & 64:
            return                                     # kolecko mysi v seznamu nic nedela
        if b & 32:                                     # pohyb
            self.hover = (y, x) if 0 <= y < len(vis) else None
            self.hover_t = time.time()
            return
        if pressed and b & 3 == 0 and y >= max(1, len(vis)):
            # nebezici pod bezicimi: klik na jmeno pusti; druhy klik dvojkliku nic nedela
            r = y - max(1, len(vis)) - 1                   # pod carou
            if 0 <= r < len(self.idle_rows) and time.time() - self.last_click[0] >= 0.4:
                for cx, text, idx in self.idle_rows[r]:
                    if idx is not None and cx <= x < cx + cwidth(text):
                        self.last_click = (time.time(), -1)
                        self.act(show(idx, True, start=True))
                        break
            return
        if not pressed or b & 3 != 0 or not 0 <= y < len(vis):
            return                                     # jen stisk leveho tlacitka na radku
        idx, label, path, st, sess = vis[y]
        now = time.time()
        double = now - self.last_click[0] < 0.4 and self.last_click[1] == y
        self.last_click = (now, y)
        if on_icon(idx, x, armed=(self.tip == y and now - self.hover_t < TIP_SECS)):
            self.hover = None
            if not double:
                self.act(deactivate(idx))              # klik na kolecko nebo stitek = /exit
        elif double:
            self.act(dblclick(idx))
        else:
            self.act(show(idx, True, start=False))

    def run(self):
        out = sys.stdout.fileno()
        os.write(out, b"\x1b[?1003h\x1b[?1006h")       # hlasit i pohyb mysi, v citelnem tvaru
        try:
            self.loop()
        finally:
            os.write(out, b"\x1b[?1003l\x1b[?1006l")

    def loop(self):
        last = 0
        while True:
            if self.winch:
                self.winch = False
                sz = os.get_terminal_size()
                curses.resizeterm(sz.lines, sz.columns)
                last = 0
            if time.time() - last >= 2:
                self.refresh_data()
                last = time.time()
            self.draw()
            for ev in self.events(1.0):
                if ev[0] == "mouse":
                    self.on_mouse(*ev[1:])
                    continue
                k = ev[1]
                if k in ("q", "Q"):
                    tmux("detach-client")
                elif k in ("up", "k"):
                    self.step(-1)
                elif k in ("down", "j"):
                    self.step(1)
                elif k in ("\r", "\n", "right"):
                    focus("agent")
                elif k.isdigit():
                    self.act(number(int(k)))
                elif k == "p":
                    self.act(toggle("pnext"))
                elif k in ("+", "="):
                    self.top_h += 1
                    self.shape = None
                    last = 0
                elif k == "-":
                    self.top_h = max(1, self.top_h - 1)
                    self.shape = None
                    last = 0
                elif k in ("z", "Z"):
                    zoom()
                else:
                    last = 0          # r a cokoli dalsiho = obnovit hned


# ---- pN: prohlizec ---------------------------------------------------------------------------
# Umi text s cisly radku, markdown vykresleny pres rich, obrazky pres chafa (i vlozene
# v md) a HTML prevedene pandocem na markdown. Nekresli pres curses: obsah je hotovy
# barevny text pro terminal a panel v nem jen listuje.
IMG_EXT = (".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp", ".svg", ".tif", ".tiff", ".ico")
MD_EXT = (".md", ".markdown")
HTML_EXT = (".html", ".htm")
IMG_TALL = 2000      # strop vysky obrazku v radcich - prakticky zadny, ridi se sirkou
DIM, BOLD, RST = "\x1b[2m", "\x1b[1m", "\x1b[0m"
C_KEY, C_HEAD, C_CODE = "\x1b[36m", "\x1b[1;35m", "\x1b[32m"
C_GIT, C_DIR = "\x1b[38;5;244m", "\x1b[1;34m"      # ● v gitu; adresar ve stromu repa
REV = "\x1b[48;5;238m"                              # rozbalene repo v seznamu rep
REPOS = "repos:"                                    # "soubor" pro prohlizec: vsechna repa pod tree z config.t2l
ESENCE = "esence:"                                  # esence:<cesta> - jedna polozka TIMEAXIS v jednom okne
TA_STEP = 25                                        # polozek na [more]; radku textu v esenci
TA_MORE = 50                                        # radku textu navic na [more] v esenci
C_BTN = "\x1b[1;33m"                                # [more] [less]
C_URL = "\x1b[4;38;5;39m"                           # externi odkaz (URL): modre, podtrzene
C_LINK = "\x1b[4m"                                  # odkaz na soubor: podtrzene, pred nim ▶▶▶
C_HOVER = "\x1b[48;5;97m\x1b[97m"                        # odkaz pod mysi: fialove
LINK_MARK = "▶▶▶ "                                  # interni odkaz a externi dokument
RE_URL = re.compile(r"https?://[^\s)\]>\"']+")
RE_HTML = re.compile(r"(?<![\w/:.-])((?:\.{1,2}/)?[\w./-]*\w\.html?)\b")


def link_row(pre, label, post, kind, hover):
    """Radek s odkazem: URL modre, soubor s ▶▶▶ pred jmenem; pod mysi fialove."""
    mark = "" if kind == "url" else LINK_MARK
    color = C_HOVER if hover else (C_URL if kind == "url" else C_LINK)
    return pre + color + mark + label + RST + post


def virtual(path):
    """Prohlizec umi i "soubory", ktere nejsou na disku: repos:, esence:<cesta>."""
    return path == REPOS or (path or "").startswith(ESENCE)


RE_IMG_MD = re.compile(r'^\s*!\[([^\]]*)\]\(\s*<?([^)\s>]+)>?(?:\s+"[^"]*")?\s*\)\s*$')
RE_IMG_HTML = re.compile(r'^\s*<img\b[^>]*\bsrc\s*=\s*["\']([^"\']+)["\'][^>]*>\s*$', re.I)
RE_ALT = re.compile(r'\balt\s*=\s*["\']([^"\']*)["\']', re.I)


def wrap_cells(s, width):
    """Rozdelit radek na kusy siroke nejvys `width` bunek terminalu."""
    if width < 4:
        width = 4
    out, cur, w = [], "", 0
    for ch in s:
        cw = cwidth(cur + ch) - w
        if w + cw > width and cur:
            out.append(cur)
            cur, w = "", 0
            cw = cwidth(ch)
        cur += ch
        w += cw
    out.append(cur)
    return out


def chafa_lines(path, width, height, fine=False):
    """Obrazek jako radky barevnych znaku. None, kdyz to nejde. fine = jemneji a pomaleji:
    sextanty (2x3 body v bunce), nejvyssi kvalita, barvy v DIN99d - pro avatara."""
    if not shutil.which("chafa"):
        return None
    extra = ["--symbols", "block+border+sextant+wedge+quad+half", "--work", "9",
             "--color-space", "din99d", "--dither", "none"] if fine else []
    try:
        r = subprocess.run(["chafa", "--format", "symbols", "--colors", "full", "--polite", "on",
                            "--animate", "off", "--size", "%dx%d" % (max(8, width), max(4, height))]
                           + extra + [path], capture_output=True, timeout=20)
    except (OSError, subprocess.SubprocessError):
        return None
    if r.returncode != 0:
        return None
    out = r.stdout.decode("utf-8", "replace").rstrip("\n")
    return [l + RST for l in out.split("\n")] if out else None


def image_block(src, base, alt, width, height):
    """Radky pro jeden obrazek: vykresleny obrazek a pod nim popisek."""
    if re.match(r"^[a-z][a-z0-9+.-]*:", src, re.I) and not src.startswith("file:"):
        return [DIM + "[obrázek z webu, nestahuje se: %s]" % src + RST]
    path = src[7:] if src.startswith("file://") else src
    if not os.path.isabs(path):
        path = os.path.join(base, path)
    if not os.path.isfile(path):
        return [DIM + "[obrázek nenalezen: %s]" % src + RST]
    lines = chafa_lines(path, width, height)
    if lines is None:
        return [DIM + "[obrázek nejde vykreslit: %s]" % src + RST]
    cap = alt or os.path.basename(path)
    try:
        from PIL import Image
        with Image.open(path) as im:
            cap += "  %dx%d" % im.size
    except Exception:
        pass
    return lines + [DIM + cap + RST]


def md_lines(text, base, width, height, imgw=None):
    """Markdown na radky pro terminal: text pres rich, obrazky na samostatnem radku pres chafa.
    imgw = sirka obrazku ve sloupcich; vysku urci pomer stran, na vysku se listuje."""
    try:
        import io
        from rich.console import Console
        from rich.markdown import Markdown
    except ImportError:
        return None

    def rich_part(src):
        if not src.strip():
            return []
        buf = io.StringIO()
        con = Console(file=buf, width=max(20, width), force_terminal=True,
                      color_system="truecolor", legacy_windows=False, highlight=False)
        con.print(Markdown(src, hyperlinks=False))
        return buf.getvalue().rstrip("\n").split("\n")

    out, chunk, fence = [], [], False
    for line in text.split("\n"):
        s = line.lstrip()
        if s.startswith("```") or s.startswith("~~~"):
            fence = not fence
        m = None if fence else RE_IMG_MD.match(line)
        h = None if fence or m else RE_IMG_HTML.match(line)
        if not m and not h:
            chunk.append(line)
            continue
        out += rich_part("\n".join(chunk))
        chunk = []
        if m:
            alt, src = m.group(1), m.group(2)
        else:
            a = RE_ALT.search(line)
            alt, src = (a.group(1) if a else ""), h.group(1)
        if out:
            out.append("")
        out += image_block(src, base, alt, imgw or width, IMG_TALL)
        out.append("")
    out += rich_part("\n".join(chunk))
    return out


def html_to_md(path):
    """HTML na markdown pres pandoc (obrazky zustanou jako ![..](..)). None, kdyz to nejde."""
    if not shutil.which("pandoc"):
        return None
    try:
        r = subprocess.run(["pandoc", "-f", "html", "-t", "gfm-raw_html", "--wrap=none", path],
                           capture_output=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return None
    return r.stdout.decode("utf-8", "replace") if r.returncode == 0 else None


class View:
    MAX = 2000000      # vic se z jednoho souboru necte

    def __init__(self, path, line=0):
        self.path = path if virtual(path) else os.path.abspath(path) if path else ""
        self.pane = os.environ.get("TMUX_PANE", "")
        self.rows = []
        self.top = 0
        self.mtime = None
        self.size = (0, 0)
        # s = prepnout vykresleny obsah / zdroj s cisly radku. Kdyz se ma ukazat
        # konkretni radek, otevira se zdroj - cislo radku plati pro nej.
        self.source = line > 0
        self.goto = line
        # Obrazek v textu je nejdriv maly, tretina sirky panelu, jen pro orientaci.
        # w ho roztahne na celou sirku a zpatky.
        self.wide = False
        self.resized = True
        self.goto_row = None
        self.jump = line > 0
        self.fd = sys.stdin.fileno()
        self.repos = None           # seznam rep (repos:), nacita se jednou; r = znovu
        self.row_repo = []          # radek -> repo
        self.open_repo = ""         # rozbalene repo
        self.ess_lines = {}         # esence: soubor -> kolik radku textu je videt
        self.ess_big = set()        # esence: obrazky zvetsene pres [more]
        self.row_act = []           # radek -> akce kliku (esence:)
        if self.pane:
            popt(self.pane, "@role", "view")
            popt(self.pane, "@file", self.path)

    def slot(self):
        """Cislo panelu pN, ve kterem prohlizec bezi (0 = nevi)."""
        if not self.pane:
            return 0
        v = tmux("show-options", "-pqv", "-t", self.pane, "@slot")[1]
        return int(v) if v.isdigit() else 0

    # -- obsah --
    def kind(self):
        ext = os.path.splitext(self.path)[1].lower()
        if ext in IMG_EXT:
            return "img"
        if ext in MD_EXT:
            return "md"
        if ext in HTML_EXT:
            return "html"
        return "text"

    def stamp(self):
        if virtual(self.path):
            return None
        try:
            return os.path.getmtime(self.path)
        except OSError:
            return None

    def read_text(self):
        """(radky, poznamka) - poznamka je duvod, proc text neni nebo neni cely."""
        try:
            size = os.path.getsize(self.path)
            with open(self.path, "rb") as f:
                data = f.read(self.MAX)
        except OSError as e:
            return None, "Nejde číst: %s" % e.strerror
        if b"\0" in data[:8192]:
            return None, "Binární soubor, %s. Text v něm není." % fsize(self.path)
        text = data.decode("utf-8", "replace").replace("\r\n", "\n")
        note = ""
        if size > self.MAX:
            note = "… zobrazeny první %d MB z %s" % (self.MAX // 1000000, fsize(self.path))
        return text, note

    def repo_rows(self, w):
        """Adresar v git repu jako strom, slozky napred (cesta k .git = cele repo).
        ● = v gitu, prazdno = neni; co git ignoruje, chybi. (radky, pocet v gitu, pocet mimo);
        None, kdyz adresar neni v repu."""
        root = self.repo_dir()

        def ls(*opt):
            r = subprocess.run(["git", "-C", root, "ls-files", "-z"] + list(opt),
                               capture_output=True, timeout=10)
            if r.returncode:
                raise OSError(0, "není v git repu")
            return [f for f in r.stdout.decode("utf-8", "replace").split("\0") if f]
        tracked = set(ls())
        tree = {}
        for f in tracked | set(ls("-o", "--exclude-standard")):
            node = tree
            for part in f.split("/")[:-1]:
                node = node.setdefault(part + "/", {})
            node[f.rsplit("/", 1)[-1]] = f
        rows = []

        def has_git(node):
            return any(has_git(v) if isinstance(v, dict) else v in tracked for v in node.values())

        def walk(node, depth):
            keys = sorted(node, key=lambda k: (not isinstance(node[k], dict), k.lower()))
            for k in keys:
                v = node[k]
                sub = isinstance(v, dict)
                dot = (C_GIT + "● " + RST) if (has_git(v) if sub else v in tracked) else "  "
                t = (wrap_cells(k, max(4, w - 4 - 2 * depth)) or [""])[0]   # dlouhe jmeno oriznout
                name = (C_DIR + t + RST) if sub else (DIM + t + RST if k.startswith(".") else t)
                rows.append(" " + dot + "  " * depth + name)
                if sub:
                    walk(v, depth + 1)
        walk(tree, 0)
        n = len(tracked)
        return rows, n, sum(1 for _ in self._files(tree)) - n

    def repos_rows(self, w):
        """Vsechna repa (adresare s .git) pod tree z config.t2l: ikona jako v CPPBROWSE
        (🈴 remark cpp, 🅰️ remark app v <repo>/<repo>.t2l, jinak 🟥), jmeno, slabe cesta.
        Pod rozbalenym repem jeho popis (record description, radky co:). Klik = rozbalit
        (jine se zavre), klik na rozbalene = otevrit v CPPBROWSE v p1."""
        if self.repos is None:
            kadlub = config.tree()
            r = subprocess.run(["find", kadlub, "-name", "node_modules", "-prune", "-o", "-name", ".venv",
                                "-prune", "-o", "-name", ".git", "-print", "-prune"],
                               capture_output=True, timeout=20)
            self.repos = sorted((os.path.dirname(g) for g in
                                 r.stdout.decode("utf-8", "replace").split("\n") if g), key=str.lower)
        rows, self.row_repo = [], []
        for d in self.repos:
            kind, desc = "", []
            try:
                with open(os.path.join(d, os.path.basename(d) + ".t2l"), encoding="utf-8") as f:
                    typ = ""
                    for line in f:
                        k, _, v = line.strip().partition(":")
                        k, v = k.strip(), v.strip()
                        if not line.strip():
                            typ = ""
                        elif k == "type":
                            typ = v
                        elif typ == "remark" and k == "value" and v in ("cpp", "app"):
                            kind = v
                        elif typ == "description" and k == "co":
                            desc.append(v)
            except OSError:
                pass
            icon = {"cpp": "🈴", "app": "🅰️"}.get(kind, "🟥")
            name = os.path.basename(d) + "/"
            pad = " " * max(2, 22 - len(name))
            on = d == self.open_repo
            rows.append((REV if on else "") + " " + icon + " " + C_DIR + name + RST
                        + (REV if on else "") + pad + DIM + short(d) + ("\x1b[K" if on else "") + RST)
            self.row_repo.append(d)
            if on:
                for t in desc or ["(popis chybí - record type: description, co: ... v %s.t2l)"
                                  % os.path.basename(d)]:
                    for part in wrap_cells(t, w - 6):
                        rows.append("     " + part)
                        self.row_repo.append(d)
                rows.append(DIM + "     klik znovu = otevřít v CPPBROWSE" + RST)
                self.row_repo.append(d)
        return rows

    def esence_rows(self, w, h):
        """Esence polozky TIMEAXIS v jednom okne: soubor sam, adresar = jeho texty a obrazky
        za sebou. Text prvnich TA_STEP radku, [more] dalsich TA_MORE, [less] zpet;
        obrazek maly, [more] zvetseny, [less] zpet."""
        root = self.path[len(ESENCE):]
        if os.path.isdir(root):
            try:
                names = sorted(os.listdir(root), key=str.lower)
            except OSError as e:
                return [DIM + str(e) + RST]
            files = [os.path.join(root, n) for n in names
                     if not n.startswith(".") and os.path.isfile(os.path.join(root, n))]
        else:
            files = [root]
        rows, self.row_act, self.links = [], [], {}
        self.hover = None

        def add(row, act=None):
            rows.append(row)
            self.row_act.append(act)

        def add_link(pre, label, post, act):
            """Radek s odkazem: ▶▶▶ pred souborem, modre URL; pod mysi fialove."""
            self.links[len(rows)] = (pre, label, post, act[0])
            add(link_row(pre, label, post, act[0], False), act)

        def add_text(part, base):
            """Radek textu; prvni URL nebo relativni html v nem je odkaz."""
            m = RE_URL.search(part)
            if m:
                return add_link(part[:m.start()], m.group(0), part[m.end():], ("url", m.group(0)))
            for m in RE_HTML.finditer(part):
                target = os.path.normpath(os.path.join(base, m.group(1)))
                if os.path.isfile(target):
                    return add_link(part[:m.start()], m.group(1), part[m.end():], ("html", target))
            add(part)
        for k, f in enumerate(files):
            ext = os.path.splitext(f)[1].lower()
            if k:
                add(DIM + "─" * max(1, w - 1) + RST)          # mezi soubory cara
            try:
                with open(f, "rb") as fh:
                    data = fh.read(self.MAX)
                text = None if ext in IMG_EXT else data.decode("utf-8")
            except (OSError, UnicodeDecodeError):
                # binarka (externi dokument): jen jmeno jako odkaz; klik = otevrit externe
                add_link(" ", os.path.basename(f), "", ("ext", f))
                continue
            if len(files) > 1:
                add_link("", os.path.basename(f), "", ("int", f))      # jmeno = interni odkaz
            if ext in IMG_EXT:
                big = f in self.ess_big
                for r in image_block(f, root, "", (w - 1) if big else max(12, (w - 1) // 3),
                                     IMG_TALL if big else max(4, h // 3)):
                    add(r)
                add(" " + C_BTN + ("[less]" if big else "[more]") + RST, ("img", f))
            else:
                lines = text.splitlines()
                n = self.ess_lines.get(f, TA_STEP)
                for ln in lines[:n]:
                    for part in wrap_cells(ln.expandtabs(4), w - 1) or [""]:
                        add_text(part, os.path.dirname(f))
                btn = []
                if n < len(lines):
                    btn.append(C_BTN + "[more]" + RST)
                if n > TA_STEP:
                    btn.append(C_BTN + "[less]" + RST)
                if btn:
                    add(" " + "  ".join(btn) + DIM + "  %d z %d řádků" % (min(n, len(lines)), len(lines))
                        + RST, ("txt", f))
        return rows

    def hover_at(self, y):
        """Mys nad radkem y obrazovky: odkaz na nem fialove, predchozi zpet."""
        i = self.top + y
        old = getattr(self, "hover", None)
        if i == old:
            return
        self.hover = i
        for j, on in ((old, False), (i, True)):
            if j is not None and j in getattr(self, "links", {}) and j < len(self.rows):
                pre, label, post, kind = self.links[j]
                self.rows[j] = link_row(pre, label, post, kind, on)

    def click(self, y, x=0):
        """Klik na radek y obrazovky (0 = nahore): seznam rep, esence:."""
        i = self.top + y
        if self.path.startswith(ESENCE):
            act = self.row_act[i] if i < len(self.row_act) else None
            if not act:
                return
            what, arg = act
            if what == "img":
                self.ess_big ^= {arg}
            elif what in ("ext", "url", "html"):
                subprocess.Popen(["xdg-open", arg], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                 start_new_session=True)
                return
            elif what == "int":
                open_right(self.pane, arg)              # soubor do panelu vpravo
                return
            elif what == "txt":
                # [more] [less] na jednom radku: less je vpravo od more, kdyz jsou oba
                n = self.ess_lines.get(arg, TA_STEP)
                row = self.rows[i]
                less = "[less]" in row and ("[more]" not in row or x > 9)
                self.ess_lines[arg] = TA_STEP if less else n + TA_MORE
            self.resized = True
            return
        if self.path != REPOS or i >= len(self.row_repo):
            return
        d = self.row_repo[i]
        if d == self.open_repo:
            show_dir({"file": d})                 # p1: CPPBROWSE vleze do repa
        else:
            self.open_repo = d
            self.resized = True

    def repo_dir(self):
        return os.path.dirname(self.path) if os.path.basename(self.path) == ".git" else self.path

    def _files(self, node):
        for v in node.values():
            if isinstance(v, dict):
                yield from self._files(v)
            else:
                yield v

    def text_rows(self, text, w):
        """Zdroj s cisly fyzickych radku; md a t2l lehce obarvene."""
        lines = [l.expandtabs(4) for l in text.split("\n")]
        if len(lines) > 1 and lines[-1] == "":
            lines.pop()
        ext = os.path.splitext(self.path)[1].lower()
        gut = len(str(max(1, len(lines)))) + 1
        rows, fence = [], False
        for i, line in enumerate(lines):
            s = line.lstrip()
            color = ""
            if ext in MD_EXT:
                if s.startswith("```") or s.startswith("~~~"):
                    fence, color = not fence, DIM
                elif fence:
                    color = C_CODE
                elif s.startswith("#"):
                    color = C_HEAD
                elif s.startswith(">"):
                    color = DIM
            elif ext == ".t2l":
                if s.startswith("#"):
                    color = DIM
                elif s.startswith("type:"):
                    color = C_HEAD
            if i + 1 == self.goto:
                self.goto_row = len(rows)
            mark = "\x1b[1;33m" if i + 1 == self.goto else DIM          # ukazany radek vyrazne
            for j, part in enumerate(wrap_cells(line, w - gut - 2)):
                num = (mark + str(i + 1).rjust(gut - 1) + RST) if j == 0 else " " * (gut - 1)
                c = part.find(":")
                if ext == ".t2l" and not color and j == 0 and c > 0:
                    body = C_KEY + part[:c + 1] + RST + part[c + 1:]      # klic: hodnota
                else:
                    body = color + part + RST
                rows.append(num + "  " + body)
        return rows, len(lines)

    def render(self, w, h):
        self.mtime = self.stamp()
        name = short(self.path) if self.path else "prázdný panel"
        note, rows, info = "", [], ""
        if not self.path:
            note = "Prázdný panel. Soubor sem dá clmon --tp%d SOUBOR." % (self.slot() or 1)
        elif self.path.startswith(ESENCE):
            name = short(self.path[len(ESENCE):])
            rows = self.esence_rows(w, h)
            info = "esence · [more] / [less]"
        elif self.path == REPOS:
            name = short_path(config.tree())
            try:
                rows = self.repos_rows(w)
                info = "%d rep · 🈴 C++  🅰️ appky  🟥 ostatní · klik = popis, znovu = CPPBROWSE · r = znovu" \
                    % len(self.repos)
            except (OSError, subprocess.SubprocessError) as e:
                note = "find nejde: %s" % e
        elif os.path.isdir(self.path):
            # adresar: v git repu strom (git list), jinak nic
            name = short(self.repo_dir())
            try:
                rows, n, other = self.repo_rows(w)
                info = "git list · ● v gitu %d · mimo git %d · r = znovu" % (n, other)
            except (OSError, subprocess.SubprocessError):
                note = "To je adresář."
        elif not os.path.exists(self.path):
            note = "Soubor není: %s" % name
        else:
            kind = self.kind()
            imgw = (w - 1) if self.wide else max(12, (w - 1) // 3)
            hint = "w = malé obrázky" if self.wide else "w = obrázky na celou šířku"
            if kind == "img":
                # samotny obrazek: nejdriv cely do panelu, w = na celou sirku s listovanim
                rows = image_block(self.path, os.path.dirname(self.path), "", w - 1,
                                   IMG_TALL if self.wide else h - 2)
                info = "obrázek · " + ("w = vejít do panelu" if self.wide else "w = celá šířka")
            else:
                text, note = self.read_text()
                if text is not None:
                    done = None
                    if not self.source and kind == "md":
                        done = md_lines(text, os.path.dirname(self.path), w - 1, h, imgw)
                        info = "md · s = zdroj · e = editor · " + hint
                    elif not self.source and kind == "html":
                        md = html_to_md(self.path)
                        if md is not None:
                            done = md_lines(md, os.path.dirname(self.path), w - 1, h, imgw)
                        info = "html jako text · s = zdroj · " + hint
                    if done is not None:
                        rows = done
                    else:
                        rows, n = self.text_rows(text, w)
                        info = "%d řádků" % n + (" · s = vykreslit" if kind in ("md", "html") else "") \
                            + " · e = editor"
        if note:
            rows = rows + ([""] if rows else []) + [DIM + note + RST]
        self.rows = rows
        self.size = (w, h)
        if self.pane:
            popt(self.pane, "@title", name + (" · " + info if info else ""))

    def top_line(self):
        """Cislo radku zdroje, ktery je prave nahore (ve zdrojovem zobrazeni)."""
        for row in self.rows[self.top:self.top + 40]:
            m = re.match(r"(?:\x1b\[[0-9;]*m)*\s*(\d+)", row)
            if m:
                return int(m.group(1))
        return 0

    # -- terminal --
    def draw(self):
        w, h = shutil.get_terminal_size((80, 24))
        if self.resized or (w, h) != self.size:
            self.resized = False
            self.goto_row = None
            self.render(w, h)
            if self.goto_row is not None and self.jump:
                self.top = max(0, self.goto_row - h // 3)      # ukazany radek do horni tretiny
                self.jump = False
        self.top = max(0, min(self.top, len(self.rows) - h))
        out = ["\x1b[H"]
        for y in range(h):
            i = self.top + y
            out.append("\x1b[%d;1H%s%s\x1b[K" % (y + 1, self.rows[i] if i < len(self.rows) else "", RST))
        os.write(sys.stdout.fileno(), "".join(out).encode("utf-8", "replace"))
        return h

    def key(self, timeout):
        """Jedna klavesa jako text: 'up', 'down', 'pgup', 'pgdn', 'home', 'end' nebo znak."""
        try:
            r, _, _ = select.select([self.fd], [], [], timeout)
        except (InterruptedError, OSError):
            return None
        if not r:
            return None
        data = os.read(self.fd, 64)
        if not data:
            raise SystemExit(0)
        names = {b"\x1b[A": "up", b"\x1bOA": "up", b"\x1b[B": "down", b"\x1bOB": "down",
                 b"\x1b[5~": "pgup", b"\x1b[6~": "pgdn", b"\x1b[H": "home", b"\x1b[1~": "home",
                 b"\x1bOH": "home", b"\x1b[F": "end", b"\x1b[4~": "end", b"\x1bOF": "end"}
        keys = []
        while data:
            m = re.match(rb"\x1b\[<(\d+);(\d+);(\d+)([Mm])", data)
            if m:
                b = int(m.group(1))
                if b == 64:
                    keys.append("up")
                elif b == 65:
                    keys.append("down")
                elif b == 0 and m.group(4) == b"M":
                    keys.append(("click", int(m.group(3)) - 1, int(m.group(2)) - 1))   # stisk leveho: radek, sloupec od 0
                elif b & 32 and m.group(4) == b"M":
                    keys.append(("move", int(m.group(3)) - 1, int(m.group(2)) - 1))    # pohyb mysi (hover)
                data = data[m.end():]
                continue
            hit = next((k for k in names if data.startswith(k)), None)
            if hit:
                keys.append(names[hit])
                data = data[len(hit):]
            elif data[:1] == b"\x1b":
                data = data[1:]
                while data and not (64 <= data[0] <= 126 and data[:1] != b"["):
                    data = data[1:]        # neznama sekvence - zahodit az po koncovy znak
                data = data[1:]
            else:
                keys.append(data[:1].decode("latin-1"))
                data = data[1:]
        return keys

    def run(self):
        import termios
        import tty
        old = termios.tcgetattr(self.fd)
        signal.signal(signal.SIGWINCH, lambda *a: setattr(self, "resized", True))
        out = sys.stdout.fileno()
        os.write(out, b"\x1b[?1049h\x1b[?25l")          # vlastni obrazovka, bez kurzoru
        mouse = virtual(self.path)                         # mys jen v seznamech a esenci; jinde jde text oznacit
        if mouse:
            # v esenci i pohyb mysi (1003): odkaz pod mysi se obarvi
            os.write(out, b"\x1b[?1000h\x1b[?1006h" + (b"\x1b[?1003h" if self.path.startswith(ESENCE) else b""))
        try:
            tty.setcbreak(self.fd)
            while True:
                h = self.draw()
                for k in self.key(1.0) or []:
                    if isinstance(k, tuple) and k[0] == "move":
                        self.hover_at(k[1])
                    elif isinstance(k, tuple):
                        self.click(k[1], k[2] if len(k) > 2 else 0)
                    elif k in ("q", "Q") and self.slot():
                        Ui.close("x%d" % self.slot())
                    elif k in ("up", "k"):
                        self.top -= 1
                    elif k in ("down", "j"):
                        self.top += 1
                    elif k in ("pgup", "b"):
                        self.top -= max(1, h - 1)
                    elif k in ("pgdn", " "):
                        self.top += max(1, h - 1)
                    elif k in ("home", "g"):
                        self.top = 0
                    elif k in ("end", "G"):
                        self.top = len(self.rows)
                    elif k in ("s", "S"):
                        self.source = not self.source
                        self.top = 0
                        self.resized = True
                    elif k in ("e", "E") and self.path and not virtual(self.path) and self.kind() != "img":
                        # editor na radku, ktery je prave nahore; spousti ho tmux zvenci
                        line = self.top_line() if self.source or self.kind() == "text" else 0
                        tmux("run-shell", "-b", "%s --tp%d %s --edit --line %d"
                             % (shlex.quote(ME), self.slot() or 1, shlex.quote(self.path), line))
                    elif k in ("w", "W"):
                        self.wide = not self.wide
                        self.resized = True
                    elif k in ("r", "R"):
                        self.repos = None
                        self.resized = True
        finally:
            termios.tcsetattr(self.fd, termios.TCSADRAIN, old)
            if mouse:
                os.write(out, b"\x1b[?1003l\x1b[?1006l\x1b[?1000l")
            os.write(out, b"\x1b[?25h\x1b[?1049l")


