def in_our_tmux(pid):
    """Bezi ten proces uvnitr naseho tmuxu? Pozna se podle TMUX v jeho prostredi."""
    try:
        env = open("/proc/%d/environ" % pid, "rb").read().split(b"\0")
    except OSError:
        return False
    for kv in env:
        if kv.startswith(b"TMUX="):
            return ("/%s," % SOCK).encode() in kv
    return False


def conf_cmd(path):
    """Vlastni prikaz z `cmd:` v projects.conf (agent, ktery neni claude, napr. Codex),
    nebo ''. Model ani kontext z clmon pro nej nejsou."""
    try:
        text = open(CONFIG_FILE, encoding="utf-8").read()
    except OSError:
        return ""
    for block in re.split(r"\n\s*\n", text):
        kv = {}
        for line in block.splitlines():
            line = line.strip()
            if line and not line.startswith("#") and ":" in line:
                k, v = line.split(":", 1)
                kv[k.strip()] = v.strip()
        if os.path.expanduser(kv.get("path", "")).rstrip("/") == path.rstrip("/"):
            return os.path.expanduser(kv.get("cmd", ""))
    return ""


