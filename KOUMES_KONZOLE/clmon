def copy_join(text):
    """Slepit radky odstavce mezerou. Prazdny radek zustava jako hranice odstavce."""
    out = []
    for para in re.split(r"\n[ \t]*(?:\n[ \t]*)+", text.strip("\n")):
        words = [l.strip() for l in para.split("\n") if l.strip()]
        if words:
            out.append(" ".join(words))
    return "\n\n".join(out)


def copy_cli(mode):
    """Vyber z terminalu agenta (prijde na vstupu) dat do schranky a ohlasit to v liste."""
    text = sys.stdin.buffer.read().decode("utf-8", "replace")
    if mode == "join":
        text = copy_join(text)
    # Prazdny vyber (klik s malym posunem mysi, jen mezery) schranku nemaze - jinak by
    # zmizelo, co si tam uzivatel dal odjinud, a vlozeni by nic nevlozilo.
    if not text.strip():
        return
    try:
        subprocess.run(["xclip", "-selection", "clipboard", "-i"], input=text.encode("utf-8"),
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
    except (OSError, subprocess.SubprocessError):
        say("do schránky to nešlo (xclip)")
        return
    say("označené je ve schránce" + (" i s řádky" if mode != "join" else ""))


def paste_cli(pane):
