def start():
    if shutil.which("tmux") is None:
        sys.exit("clmon: chybí tmux (sudo apt install tmux)")
    if os.environ.get("TMUX"):
        sys.exit("clmon: už jsi uvnitř tmuxu - pusť clmon v obyčejném terminálu")
    if not server_up():
        cols, rows = shutil.get_terminal_size((200, 50))
        # seznam se po padu pusti znovu; q ho neukoncuje, jen odpoji klienta
        loop = "while :; do %s --list; sleep 1; done" % shlex.quote(ME)
        rc, _ = tmux("-f", TMUX_CONF, "new-session", "-d", "-s", "ui", "-n", "clmon4",
                     "-x", cols, "-y", rows, "-c", HOME, loop)
        if rc != 0:
            sys.exit("clmon: tmux se nepodařilo spustit")
    # okno terminalu, ve kterem clmon4 bezi - pres nej se pridava a ubira sirka
    gopt("@winid", os.environ.get("CLMON4_WINID") or active_window())
    os.execvp("tmux", ["tmux", "-L", SOCK, "attach-session", "-t", "ui"])


def kill():
    if not server_up():
        print("clmon neběží")
        return
    for p in panes():
        if p["agent"] and p["role"] != "idle":
            print("ukončuji:", p["agent"])
    tmux("kill-server")


def snapshot(what):
    """Obsah panelu pN nebo okna agenta (agent) i s barvami jako blok ```monospace; None = neni."""
    L = lay()
    m = re.fullmatch(r"p(\d+)", what or "")
    p = panel(L, int(m.group(1))) if m else L["main"] if what == "agent" else None
    if not p:
        return None
    rc, out = tmux("capture-pane", "-e", "-p", "-t", p["id"])
    if rc:
        return None
    rows = [r.rstrip() for r in out.split("\n")]
    while rows and not rows[-1]:
        rows.pop()
    text = "\n".join(rows)
    fence = "````" if "```" in text else "```"             # obsah s ``` blok neukonci
    return "%smonospace\n%s\n%s\n" % (fence, text, fence)


def arg_after(args, flag, default=None):
    i = args.index(flag)
    return args[i + 1] if i + 1 < len(args) else default


def use_apps_config():
    """apps.t2l (databaze konzole) - kdyz chybi, vytvori ho apps.py; editor bere z nej."""
    global HX
    try:
        sys.path.insert(0, SCRIPT_DIR)
        import apps
        HX = apps.editor() or HX
    except (ImportError, OSError):
        pass


def use_config(seen=None):
    """config.t2l do konstant; seen = mtime posledniho nacteni, kdyz se nezmenil, nic.
    Vraci mtime. CLMON4_CONF (zkouseni nanecisto) ma prednost."""
    global CONFIG_FILE, WORKERS_DIR, AVATAR_DIR, DIAG_SCRIPT, DIAG_FILE, DIAG_PYTHON, PANEL_PORT, KOUMES_PORT
    config.ensure()
    now = os.path.getmtime(config.CONFIG_T2L)
    if now == seen:
        return now
    CONFIG_FILE = os.environ.get("CLMON4_CONF") or config.place("agents")
    WORKERS_DIR, AVATAR_DIR = config.place("workers"), config.place("avatars")
    PANEL_PORT, KOUMES_PORT = config.number("panel_port", PANEL_PORT), config.number("koumes_port", KOUMES_PORT)
    for d in (KOUMES_CODE, KOUMES_PORTS, KOUMES_ROOTS, KOUMES_PYTHON):
        d.clear()
    for r in config.records("koumes"):
        if r.get("id") and r.get("code") and r.get("root") and r.get("port", "").isdigit():
            n = r["id"]
            KOUMES_CODE[n], KOUMES_ROOTS[n] = config.expand(r["code"]), config.expand(r["root"])
            KOUMES_PORTS[n] = int(r["port"])
            KOUMES_PYTHON[n] = config.expand(r.get("python", "")) or sys.executable
    d = next(iter(config.records("diag")), {})
    DIAG_SCRIPT, DIAG_FILE = config.expand(d.get("script", "")), config.expand(d.get("file", ""))
    DIAG_PYTHON = config.expand(d.get("python", "")) or sys.executable
    return now


def main():
    args = sys.argv[1:]
    use_apps_config()
    use_config()
    if args[:1] == ["--config"]:
        # --config <klic> [hodnota]: totez, co appka config_view; bez hodnoty = vypnout
        err = config.assign(args[1], " ".join(args[2:])) if len(args) > 1 else "--config KEY [VALUE]"
        if err:
            sys.exit("clmon: " + err)
        return
    if "-h" in args or "--help" in args:
        head = open(ME, encoding="utf-8").read().split("\n\n")[0]
        print("\n".join(l[2:] if l.startswith("# ") else l.lstrip("#")
                        for l in head.splitlines()[1:]))
        return
    if "--kill" in args:
        kill()
        return
    if "--close" in args:
        close_all()
        return
    if "--clamp" in args:
        clamp()
        return
    if "--fit" in args:
        if not busy():
            fit()
        return
    if "--paste" in args:
        paste_cli(arg_after(args, "--paste", ""))
        return
    if "--copy" in args:
        copy_cli(arg_after(args, "--copy", "join"))
        return
    if "--say" in args:
        say(arg_after(args, "--say", ""))
        return
    if "--start" in args or "--free-worker" in args:
        if not server_up():
            sys.exit("clmon is not running - start it with the command clmon")
        if "--free-worker" in args:
            idx = free_worker()
            if idx < 0:
                sys.exit("žádný worker není volný")
            print(entries()[idx][0])
            return
        err = start_cli(arg_after(args, "--start", ""))
        if err:
            sys.exit("clmon: " + err)
        return
    if "--dblstatus" in args:
        name = arg_after(args, "--dblstatus", "")
        if re.fullmatch(r"a\d+", name or ""):
            err = dblclick(int(name[1:]))
            if err:
                say(err)
        return
    for flag in ("--click", "--dblclick"):
        if flag in args:
            i = args.index(flag)
            try:
                y = int(args[i + 1])
                x = int(args[i + 2]) if i + 2 < len(args) else 99
            except (IndexError, ValueError):
                return
            err = list_click(y, x, double=(flag == "--dblclick"))
            if err:
                say(err)
            return
    for flag, fn in (("--number", number),):
        if flag in args:
            try:
                n = int(arg_after(args, flag, ""))
            except ValueError:
                return
            err = fn(n)
            if err:
                say(err)
            return
    if "--toggle" in args:
        err = toggle(arg_after(args, "--toggle", ""))
        if err:
            say(err)
        return
    if "--focus-list" in args:
        focus("list")
        return
    if "--focus-agent" in args:
        focus("agent")
        return
    if "--zoom" in args:
        zoom()
        return
    if "--reload" in args:
        lp = lay()["list"]
        if not lp:
            sys.exit("clmon neběží")
        tmux("respawn-pane", "-k", "-t", lp["id"])      # jen seznam, agenti bezi dal
        return
    if "--idle" in args:
        idle()
        return
    if "--tbar" in args:
        tbar()
        return
    if "--menu" in args:
        menu()
        return
    if "--stitek" in args:
        stitek()
        return
    if "--avatar" in args:
        avatar()
        return
    if "--view" in args:
        try:
            line = int(arg_after(args, "--line", "0")) if "--line" in args else 0
        except ValueError:
            line = 0
        View(arg_after(args, "--view", ""), line).run()
        return
    if "--show-dir" in args:
        # adresar v dirview v p1 (repos.py: klik na rozbalene repo)
        err = show_dir({"file": arg_after(args, "--show-dir", "")})
        if err:
            sys.exit(err)
        return
    if "--open-right" in args:
        i = args.index("--open-right")
        if i + 2 >= len(args) or not server_up():
            sys.exit("clmon: --open-right PANEL SOUBOR, a clmon musí běžet")
        err = open_right(args[i + 1], args[i + 2], "--viewer" in args)
        if err:
            say(err)
            sys.exit("clmon: " + err)
        return
    if args[:1] == ["--switch"]:
        # prepinac prohlizece na stitku: --switch pN view|hx|ext <bin>
        if len(args) < 3 or not re.fullmatch(r"p\d+", args[1]) or not server_up():
            sys.exit("clmon: --switch pN view|hx|ext <bin>, a clmon musí běžet")
        err = switch_panel(int(args[1][1:]), args[2], arg_after(args, "ext", "") if args[2] == "ext" else "")
        if err:
            sys.exit("clmon: " + err)
        return
    if args[:1] == ["--snapshot"]:
        what = args[1] if len(args) > 1 else ""
        md = snapshot(what)
        if md is None:
            sys.exit("clmon: --snapshot pN|agent: nothing there")
        if "--to" in args:
            with open(arg_after(args, "--to"), "a", encoding="utf-8") as f:
                f.write("\n" + md)
        elif "--aicom" in args:
            name = arg_after(args, "--aicom", "") or "snapshot_" + what
            sys.exit(subprocess.run([AICOM_TOOL, "write", name], input=md.encode("utf-8")).returncode)
        else:
            sys.stdout.write(md)
        return
    if args[:1] == ["--in_test"]:
        # appka v panelu pN ukaze okynko, ze na ni nekdo testuje (jako diag_cross u diagu)
        if len(args) < 3 or not re.fullmatch(r"p\d+", args[1]) or not server_up():
            sys.exit("clmon: --in_test pN <agent> [--msg TEXT] | off, a clmon musí běžet")
        p = panel(lay(), int(args[1][1:]))
        if not p:
            sys.exit("clmon: panel %s není" % args[1])
        msg = arg_after(args, "--msg", "") if "--msg" in args else ""
        rest = args[2:args.index("--msg")] if "--msg" in args else args[2:]
        who = "" if args[2] == "off" else " ".join(rest)
        if who:                                   # jmeno s ikonou z projects.conf: "🤖 KOUMES"
            who = next((v for v in load_conf_names().values()
                        if v.split()[-1].upper() == who.split()[-1].upper()), who)
        popt(p["id"], "@test_img", (avatar_path(who) or "") if who else "")   # obrazek agenta
        popt(p["id"], "@test_msg", msg if who else "")   # co testuje; \\n = novy radek (appka)
        popt(p["id"], "@test", who)
        return
    if args[:1] == ["--port"]:
        # port programu v panelu pN (panely se daji prohodit, port jde s programem)
        if len(args) < 2 or not re.fullmatch(r"p\d+", args[1]) or not server_up():
            sys.exit("clmon: --port pN, a clmon musí běžet")
        p = panel(lay(), int(args[1][1:]))
        if not p or not p["port"]:
            sys.exit("clmon: v %s neběží program s portem" % args[1])
        print(p["port"])
        return
    tpf = next((a for a in args if re.fullmatch(r"--t[px]\d+", a)), None)
    if "--where" in args or tpf:
        if not server_up():
            sys.exit("clmon is not running - start it with the command clmon")
        if "--where" in args:
            where()
            return
        n = int(tpf[4:])
        if not 1 <= n <= PANEL_MAX:
            sys.exit("clmon: panely jsou p1 až p%d" % PANEL_MAX)
        if tpf.startswith("--tx"):
            err = close_panel(n)
        else:
            try:
                line = int(arg_after(args, "--line", "0")) if "--line" in args else 0
            except ValueError:
                line = 0
            err = tp(n, "" if "--run" in args else arg_after(args, tpf, ""), line, "--edit" in args,
                     arg_after(args, "--run", "") if "--run" in args else "", "--hx" in args)
        if err:
            sys.exit("clmon: " + err)
        return
    if "--list" in args:
        locale.setlocale(locale.LC_ALL, "")
        curses.wrapper(lambda scr: ListUi(scr).run())
        return
    start()


if __name__ == "__main__":
    main()
