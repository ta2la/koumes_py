# ---- okno terminalu: pridavat a ubirat sirku ----------------------------------------------
# Panel pN se neotvira na ukor toho, co uz na obrazovce je: okno terminalu se
# o nej rozsiri a po zavreni zase zuzi. Jde to pres wmctrl, kdyz okno neni maximalizovane.
def xrun(*cmd):
    try:
        r = subprocess.run(list(cmd), capture_output=True, text=True, timeout=3)
    except (OSError, subprocess.SubprocessError):
        return ""
    return r.stdout if r.returncode == 0 else ""


def active_window():
    out = xrun("xprop", "-root", "_NET_ACTIVE_WINDOW")
    wid = out.strip().split()[-1] if out.strip() else ""
    return wid if wid.startswith("0x") and int(wid, 16) else ""


def window_width():
    rc, out = tmux("display-message", "-p", "-t", "ui:", "#{window_width}")
    try:
        return int(out)
    except ValueError:
        return 0


def our_window():
    """Id okna terminalu, ve kterem clmon4 bezi. Pozna se podle titulku, ktery oknu
    dava tmux (= jmeno socketu) - cizi okno se tak nikdy nezmeni."""
    wid = gopt("@winid")
    if wid and ('"%s"' % SOCK) in xrun("xprop", "-id", wid, "_NET_WM_NAME"):
        return wid
    for line in xrun("wmctrl", "-l").splitlines():
        parts = line.split(None, 3)
        if len(parts) == 4 and parts[3].strip() == SOCK:
            gopt("@winid", parts[0])
            return parts[0]
    return ""


def grow(cols):
    """Rozsirit (cols > 0) nebo zuzit (cols < 0) okno terminalu o dany pocet sloupcu.
    Vraci True, kdyz se sirka v tmuxu opravdu zmenila."""
    if not cols or not tmux("list-clients", "-t", "ui")[1]:
        return False
    wid = our_window()
    if not wid:
        return False
    state = xrun("xprop", "-id", wid, "_NET_WM_STATE", "WM_NORMAL_HINTS")
    if not state or "MAXIMIZED_HORZ" in state or "FULLSCREEN" in state:
        return False
    inc = 0
    for line in state.splitlines():
        if "resize increment" in line:
            try:
                inc = int(line.split(":")[1].split("by")[0])
            except (IndexError, ValueError):
                inc = 0
    info = xrun("xwininfo", "-id", wid)
    try:
        px = int(next(l for l in info.splitlines() if "Width:" in l).split()[-1])
    except (StopIteration, ValueError):
        return False
    if inc <= 0 or px <= 0:
        return False
    before = window_width()
    target = px + cols * inc
    xrun("wmctrl", "-i", "-r", wid, "-e", "0,-1,-1,%d,-1" % target)
    for _ in range(30):                   # pockat, az se zmena propise do tmuxu
        time.sleep(0.05)
        if window_width() != before:
            break
    return window_width() != before


# ---- rozlozeni: panely pres celou vysku vedle sebe -----------------------------------------
#   levy panel = seznam nahore + terminal agenta pod nim · vpravo od nej panely p1, p2, ...
def touch():
    """Oznacit, ze rozlozeni prave meni clmon4 sam. Seznam podle toho pozna, ze
    zmena velikosti panelu neni tazeni mysi, a neulozi si ji jako volbu uzivatele."""
    gopt("@gen", "%.3f" % time.time())


def want_w(n):
    """Sirka noveho panelu pN - vzdy vychozi, zadne pamatovani."""
    return P1_W


def cell_px():
    """Sirka jednoho sloupce terminalu v pixelech (resize increment okna), jinak 9."""
    wid = our_window()
    for line in (xrun("xprop", "-id", wid, "WM_NORMAL_HINTS") if wid else "").splitlines():
        if "resize increment" in line:
            try:
                return max(1, int(line.split(":")[1].split("by")[0]))
            except (IndexError, ValueError):
                pass
    return 9


# ---- sirky sloupcu --------------------------------------------------------------------------
# Tri pravidla, nic jineho:
#   1. vnitrni hrana meni jen dva sousedni sloupce (tak to tmux dela sam),
#   2. vnejsi hrana okna meni jen krajni sloupec,
#   3. pod MIN_PX zadny sloupec nejde.
# Sloupce: 0 = levy (seznam + agent), pak panely pN zleva doprava. @cols drzi sirky,
# jak byly naposled spravne; z nich se vychazi pri zmene okna.
def min_cols(fresh=False):
    """MIN_PX ve sloupcich terminalu (nahoru). Drzi se v @mn, at tazeni nevola xprop."""
    try:
        v = 0 if fresh else int(gopt("@mn") or 0)
    except ValueError:
        v = 0
    if v <= 0:
        v = -(-MIN_PX // cell_px())
        gopt("@mn", str(v))
    return v


def columns(L):
    """Sloupce zleva: (klic, pane). Levy sloupec ma celou sirku v menu nad seznamem."""
    return [(0, L["menu"] or L["list"])] + [(p["slot"], p) for p in L["panels"]]


def saved_cols():
    cols = {}
    for part in (gopt("@cols") or "").split(","):
        k, _, v = part.partition(":")
        if k.isdigit() and v.isdigit():
            cols[int(k)] = int(v)
    return cols


def save_cols(keys, ws):
    gopt("@cols", ",".join("%d:%d" % kw for kw in zip(keys, ws)))


def apply_cols(L, ws):
    """Nastavit sirky sloupcu zleva doprava; posledni ma, co zbude."""
    cs = columns(L)
    touch()
    for (k, p), w in list(zip(cs, ws))[:-1]:
        tmux("resize-pane", "-t", p["id"], "-x", w)
    touch()
    save_cols([k for k, p in cs], ws)


def edge_fit(ws, room, mn, right=True):
    """Rozdil mista jde cely do krajniho sloupce. Kdyz ten pri zmensovani narazi na
    minimum, bere se dalsimu smerem dovnitr, jeden po druhem - nikdy v pomeru."""
    ws = list(ws)
    delta = room - sum(ws)
    order = list(range(len(ws) - 1, -1, -1)) if right else list(range(len(ws)))
    if delta > 0:
        ws[order[0]] += delta
        return ws
    for i in order:
        d = min(-delta, max(0, ws[i] - mn))
        ws[i] -= d
        delta += d
        if not delta:
            break
    return ws


def window_x():
    """Pozice leve hrany okna terminalu na obrazovce (nebo None)."""
    wid = our_window()
    for line in (xrun("xwininfo", "-id", wid) if wid else "").splitlines():
        if "Absolute upper-left X" in line:
            try:
                return int(line.split(":")[1])
            except ValueError:
                pass
    return None


def busy(on=None):
    """clmon4 prave sam otevira nebo zavira panel - hook pri zmene okna ma pockat.
    Bez parametru: plati jeste? (starsi nez 5 s se nepocita, kdyby neco spadlo)."""
    if on is not None:
        gopt("@busy", "%.3f" % time.time() if on else "")
        return on
    try:
        return time.time() - float(gopt("@busy") or 0) < 5
    except ValueError:
        return False


def fit(base=None, right=None):
    """Po zmene okna: sloupce zustanou, jak byly (@cols, nebo `base`), rozdil sirky dostane
    jen krajni sloupec - pravy, nebo levy, kdyz se pohnula leva hrana okna."""
    L = lay()
    lp = L["list"]
    if not lp or lp["zoom"] or not L["panels"]:
        return
    cs = columns(L)
    keys = [k for k, p in cs]
    cur = [p["w"] for k, p in cs]
    room = lp["ww"] - (len(cs) - 1)
    if base is None or len(base) != len(cs):
        saved = saved_cols()
        base = [saved.get(k, w) for k, w in zip(keys, cur)]
        if sum(base) == room:
            # okno se nezmenilo - co je na obrazovce, je volba uzivatele (tazeni hrany,
            # ktere se nestihlo zapamatovat), nic nevracet
            save_cols(keys, cur)
            return
    x, old = window_x(), gopt("@winx")
    if x is not None:
        gopt("@winx", str(x))
    if right is None:
        right = not (x is not None and old and str(x) != old)
    ws = edge_fit(base, room, min_cols(True), right)
    if ws != cur:
        apply_cols(L, ws)
    else:
        save_cols(keys, ws)


def clamp():
    """Tazeni hrany (kazdy pohyb mysi): tmux meni jen dva sousedy. Kdo spadne pod MIN_PX,
    vrati se na minimum a dorovna to ten, kdo tazenim narostl. Jinak se jen zapamatuji
    sirky, jak jsou. Behem tazeni chodi udalosti rychleji, nez skript dobehne - ktery
    prijde, kdyz predchozi jeste bezi, skonci hned."""
    import fcntl
    lk = open(os.path.join(tempfile.gettempdir(), "clmon4-%s-clamp.lock" % SOCK), "w")
    try:
        fcntl.flock(lk, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return
    L = lay()
    lp = L["list"]
    if not lp or lp["zoom"] or not L["panels"]:
        return
    cs = columns(L)
    keys = [k for k, p in cs]
    cur = [p["w"] for k, p in cs]
    mn = min_cols()
    if all(w >= mn for w in cur):
        save_cols(keys, cur)
        return
    saved = saved_cols()
    gain = [w - saved.get(k, w) for k, w in zip(keys, cur)]
    ws = [max(w, mn) for w in cur]
    extra = sum(ws) - sum(cur)
    for i in sorted(range(len(ws)), key=lambda i: -gain[i]):   # nejdriv ten, kdo narostl
        d = min(extra, max(0, ws[i] - mn))
        ws[i] -= d
        extra -= d
        if not extra:
            break
    apply_cols(L, ws)


def ensure_main(L=None):
    """Kdyz pod seznamem neni terminal agenta, zalozit prazdne misto s napovedou."""
    L = L or lay()
    if L["main"]:
        return L["main"]["id"]
    touch()
    rc, pid = tmux("split-window", "-d", "-v", "-t", L["list"]["id"], "-c", HOME,
                   "-P", "-F", "#{pane_id}", "%s --idle" % shlex.quote(ME))
    if rc != 0 or not pid:
        return None
    popt(pid, "@role", "idle")
    popt(pid, "@agent", IDLE)
    return pid


def active_path():
    """Adresar agenta, ktery je prave dole (nebo None)."""
    main = lay()["main"]
    if not main:
        return None
    return next((path for label, path in entries() if label == main["agent"]), None)


def add_panel(role, width, cwd, cmd):
    """Pridat panel pres celou vysku uplne vpravo; okno se o nej nejdriv rozsiri."""
    L = lay()
    if not L["list"]:
        return None
    touch()
    grow(width + 1)                       # +1 je hrana mezi panely
    rc, pid = tmux("split-window", "-d", "-h", "-f", "-t", L["list"]["id"], "-l", width,
                   "-c", cwd, "-P", "-F", "#{pane_id}", cmd)
    if rc != 0 or not pid:
        return None
    popt(pid, "@role", role)
    return pid


def drop_panel(pane):
    """Zavrit panel i s jeho listou nastroju a stitkem a okno o nej zase zuzit."""
    width = pane["w"]
    touch()
    L = lay()
    keep = [p["w"] for k, p in columns(L) if p["id"] != pane["id"]] if L["list"] else None
    busy(True)
    for b in L["tbars"] + L["stitky"]:
        if b["x"] == pane["x"]:
            tmux("kill-pane", "-t", b["id"])
    tmux("kill-pane", "-t", pane["id"])
    grow(-(width + 1))
    fit(keep, right=True)                 # ostatni sloupce zustanou, jak byly
    busy(False)
    touch()


def ensure_tbars(L=None):
    """Kazdy panel pN ma nahore svou listu nastroju, vysokou TBAR_H radku.
    Levy sloupec ma nad seznamem menu s tlacitky. Chybejici zalozit, lista bez sloupce
    pod sebou zmizi, vysku drzet."""
    L = L or lay()
    if not L["list"] or L["list"]["zoom"]:
        return False
    changed = False
    lp, menu = L["list"], L["menu"]
    if not menu:
        # Misto pro menu se vezme seznamu; ten si pak svou vysku vrati na ukor agenta.
        touch()
        tmux("resize-pane", "-t", lp["id"], "-y", lp["h"] + TBAR_H + 1)
        rc, pid = tmux("split-window", "-d", "-v", "-b", "-l", TBAR_H, "-t", lp["id"],
                       "-c", HOME, "-P", "-F", "#{pane_id}",
                       "while :; do %s --menu; sleep 1; done" % shlex.quote(ME))
        if rc == 0 and pid:
            popt(pid, "@role", "menu")
            changed = True
    elif menu["h"] != TBAR_H:
        touch()
        tmux("resize-pane", "-t", menu["id"], "-y", TBAR_H)
        changed = True
    mine = []
    for col in L["panels"]:
        tb = L["tb"].get(col["slot"])
        if tb:
            mine.append(tb["id"])
            if tb["h"] != TBAR_H:
                touch()
                tmux("resize-pane", "-t", tb["id"], "-y", TBAR_H)
                changed = True
            continue
        touch()
        rc, pid = tmux("split-window", "-d", "-v", "-b", "-l", TBAR_H, "-t", col["id"],
                       "-c", HOME, "-P", "-F", "#{pane_id}",
                       "while :; do %s --tbar; sleep 1; done" % shlex.quote(ME))
        if rc == 0 and pid:
            popt(pid, "@role", "tbar")
            mine.append(pid)
            changed = True
    # pod listou stitek: tim, ze se deli panel s obsahem (-b), padne mezi listu a obsah
    for col in L["panels"]:
        st = L["st"].get(col["slot"])
        if st:
            mine.append(st["id"])
            if st["h"] != STITEK_H:
                touch()
                tmux("resize-pane", "-t", st["id"], "-y", STITEK_H)
                changed = True
            continue
        touch()
        rc, pid = tmux("split-window", "-d", "-v", "-b", "-l", STITEK_H, "-t", col["id"],
                       "-c", HOME, "-P", "-F", "#{pane_id}",
                       "while :; do %s --stitek; sleep 1; done" % shlex.quote(ME))
        if rc == 0 and pid:
            popt(pid, "@role", "stitek")
            popt(pid, "pane-border-format", DASH)
            popt(col["id"], "pane-border-format", INNER_FMT)
            mine.append(pid)
            changed = True
    for b in L["tbars"] + L["stitky"]:
        if b["id"] not in mine:
            touch()
            tmux("kill-pane", "-t", b["id"])
            changed = True
    if changed:
        touch()
    return changed


def tbar():
    """Lista nastroju nad panelem pN: vlevo cislo panelu, vpravo zamek [🔒] a [x], ktere
    panel zavre. Ke kteremu panelu patri, pozna podle sve
    polohy. Klik si cte sama; po zmene kodu skonci a smycka ji pusti znovu."""
    import termios
    code = os.path.getmtime(ME)
    me = os.environ.get("TMUX_PANE", "")
    fd = sys.stdin.fileno()
    try:
        old = termios.tcgetattr(fd)
        new = termios.tcgetattr(fd)
        new[3] &= ~(termios.ECHO | termios.ICANON)       # psani do listy nic nevypise
        termios.tcsetattr(fd, termios.TCSANOW, new)
    except termios.error:
        old = None
    out = sys.stdout
    out.write("\x1b[?25l\x1b[?7l\x1b[?1000h\x1b[?1006h")
    BG, FG = "\x1b[48;5;235m", "\x1b[22;38;5;250m"
    shown, buttons = None, []          # buttons = [(radek, od, do, akce)] - radky a sloupce od 1
    try:
        while os.path.getmtime(ME) == code:
            L = lay()
            n = next((s for s, b in L["tb"].items() if b and b["id"] == me), 0)
            p = panel(L, n) if n else None
            chat = bool(p and p["role"] == "chat")
            lock = bool(p and p["lock"])
            role = "refresh" if refresh_keys(p) else ""
            updir = bool(p and p["role"] in ("view", "edit", "hx") and p["file"])
            sh = bool(p and p["role"] == "sh")
            size = shutil.get_terminal_size((80, TBAR_H))
            slots = [q["slot"] for q in L["panels"]]
            left = bool(slots) and n in slots and slots.index(n) > 0          # [<] jen kdyz je vlevo soused
            right = bool(slots) and n in slots and slots.index(n) < len(slots) - 1
            state = (size, n, chat, lock, role, updir, sh, left, right)
            if state != shown:
                buttons = []
                if n:
                    head = " p%d" % n
                    x = 1 + cwidth(head)
                    row = "\x1b[1;38;5;252m%s%s" % (head, FG)
                    # vlevo za cislem appky do tohohle panelu: [repos], [>_] konzole (znovu = zpet),
                    # [timeax] a [aicom] dirview v tom rezimu, [apps] prehled appek konzole
                    rp, sk, ta, ap = "[repos]", "[>_]", "[timeax]" if config.place("timeaxis") else "", "[apps]"
                    ac, ln = ("[aicom]", "[remarks]") if ta else ("", "")
                    if x + 6 + len(rp) + len(sk) + len(ta) + len(ac) + len(ln) + len(ap) < size.columns:
                        buttons.append((1, x + 1, x + len(rp), "repos%d" % n))
                        row += " \x1b[38;5;110m%s%s" % (rp, FG)
                        x += 1 + len(rp)
                        buttons.append((1, x + 1, x + len(sk), "sh%d" % n))
                        row += " %s\x1b[38;5;%dm%s%s" % ("\x1b[1m" if sh else "", 214 if sh else 110, sk, FG)
                        x += 1 + len(sk)
                        if ta:
                            buttons.append((1, x + 1, x + len(ta), "timeax%d" % n))
                            row += " \x1b[38;5;110m%s%s" % (ta, FG)
                            x += 1 + len(ta)
                            buttons.append((1, x + 1, x + len(ac), "aicom%d" % n))
                            row += " \x1b[38;5;110m%s%s" % (ac, FG)
                            x += 1 + len(ac)
                            buttons.append((1, x + 1, x + len(ln), "remarks%d" % n))
                            row += " \x1b[38;5;110m%s%s" % (ln, FG)
                            x += 1 + len(ln)
                        buttons.append((1, x + 1, x + len(ap), "apps%d" % n))
                        row += " \x1b[38;5;110m%s%s" % (ap, FG)
                        x += 1 + len(ap)
                    # vpravo na druhem radku: [← dir] [🔃] [🔒] [<][>] [x]
                    # [🔒] zamek (zamceny panel se neprepisuje, dalsi obsah jde vedle), [x] zavre
                    lk = "[🔒]" if lock else "[🔓]"
                    lw = cwidth(lk)
                    xw = size.columns - 3                 # [x] uplne vpravo
                    xm = xw - 1 - 6                       # [<][>] posunout panel, hned pred [x]
                    xl = xm - 1 - lw
                    rf = "[🔃]" if role else ""
                    rw = cwidth(rf)
                    xr = xl - 1 - rw if rf else xl        # [🔃] obnovit, pred zamkem, jen u REFRESH
                    ud = "[← dir]" if updir else ""
                    xd = xr - 1 - cwidth(ud) if ud else xr   # [← dir] pred [🔃]
                    row2 = ""
                    if xd > 1:
                        if ud:
                            buttons.append((2, xd, xd + cwidth(ud) - 1, "updir%d" % n))
                        if rf:
                            buttons.append((2, xr, xr + rw - 1, "refresh%d" % n))
                        buttons.append((2, xl, xl + lw - 1, "lock%d" % n))
                        if left:
                            buttons.append((2, xm, xm + 2, "mvl%d" % n))
                        if right:
                            buttons.append((2, xm + 3, xm + 5, "mvr%d" % n))
                        buttons.append((2, xw, xw + 2, "x%d" % n))
                        row2 = " " * (xd - 1)
                        if ud:
                            row2 += "\x1b[38;5;110m%s%s " % (ud, FG)
                        if rf:
                            row2 += "\x1b[38;5;110m%s%s " % (rf, FG)
                        # [<][>] u krajniho panelu tlumene, tam neni s kym prohodit
                        mv = "\x1b[38;5;%dm[<]\x1b[38;5;%dm[>]%s" % (110 if left else 238,
                                                                     110 if right else 238, FG)
                        row2 += "%s\x1b[38;5;%dm%s%s %s \x1b[38;5;174m[x]%s" % (
                            "\x1b[1m" if lock else "", 214 if lock else 242, lk, FG, mv, FG)
                else:
                    row, row2 = "", ""
                rows = ([row, row2] + [""] * size.lines)[:size.lines]
                out.write("".join("\x1b[%d;1H%s%s%s\x1b[K" % (i + 1, BG, FG, r)
                                  for i, r in enumerate(rows)) + "\x1b[0m")
                out.flush()
                shown = state
            r, _, _ = select.select([fd], [], [], 0.5)
            if not r:
                continue
            data = os.read(fd, 1024)                      # klavesy do listy zahodit
            for m in RE_SGR.finditer(data):
                b, mx, my = int(m.group(1)), int(m.group(2)), int(m.group(3))
                if b != 0 or m.group(4) != b"M":
                    continue
                hit = next((a for y, x0, x1, a in buttons if y == my and x0 <= mx <= x1), None)
                if hit:
                    subprocess.Popen([ME, "--toggle", hit], stdin=subprocess.DEVNULL,
                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                     start_new_session=True)
    finally:
        out.write("\x1b[?1000l\x1b[?1006l\x1b[?7h\x1b[?25h")
        out.flush()
        if old:
            termios.tcsetattr(fd, termios.TCSANOW, old)


APP_NAME = {"view": "prohlížeč", "edit": "micro", "hx": "helix", "chat": "pindání", "sh": "konzole"}


def panel_app(p):
    """Cim panel p jede: helix, micro, prohlizec, pindani, nebo jmeno programu (i s portem)."""
    if not p:
        return ""
    if p["role"] == "run":
        return run_prog(p["run"]) + (" · port %d" % p["port"] if p["port"] else "")
    return APP_NAME.get(p["role"], p["role"])


def is_binary(path):
    try:
        with open(path, "rb") as f:
            return b"\0" in f.read(8192)
    except OSError:
        return True


def switch_options(p, shows=""):
    """Prepinac prohlizece na stitku: cim vsim jde to, co panel ukazuje, zobrazit - podle
    apps.t2l. [(popisek, interni, aktivni, argumenty pro --switch)]. Interni = v panelu
    ([viewer], [helix], [git_list]), externi = vlastni okno (↗eog, ↗xdg-open)."""
    dv = bool(p) and p["role"] == "run" and run_prog(p["run"]) == os.path.basename(DIR_VIEWER)
    if not p or not (p["role"] in ("view", "hx", "edit") and p["file"] or dv and shows):
        return []
    path = os.path.expanduser(shows) if dv else p["file"]
    if not os.path.exists(path):
        return []
    out = []
    if os.path.isdir(path):                               # adresar: dirview i git list (najde si repo)
        out.append(("[dirview]", True, dv, ["dirview"]))
        out.append(("[git_list]", True, p["role"] == "view", ["view"]))
    else:
        out.append(("[viewer]", True, p["role"] == "view", ["view"]))
        if not is_binary(path) and shutil.which(HX):
            out.append(("[helix]", True, p["role"] == "hx", ["hx"]))
    try:
        sys.path.insert(0, SCRIPT_DIR)
        import apps
        seen = set()
        for b in (apps.bin_for(path), "xdg-open"):
            if b and b not in seen and shutil.which(b):
                seen.add(b)
                out.append(("↗" + b, False, False, ["ext", b]))
    except (ImportError, OSError):
        pass
    return out


def switch_panel(n, how, prog=""):
    """--switch pN view|hx|dirview|ext <bin>: interni = soubor panelu v tom programu v panelu,
    externi = tentyz soubor v okne externi appky."""
    p = panel(lay(), n)
    path = (os.path.expanduser(panel_shows(p)) if p and p["role"] == "run" else p["file"]) if p else ""
    if not path:
        return "p%d nic neukazuje" % n
    if how == "ext":
        subprocess.Popen([prog, path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
        return None
    if how == "dirview":
        return tp(n, None, run="%s %s" % (shlex.quote(DIR_VIEWER), shlex.quote(path)))
    return tp(n, path, hx=how == "hx")


def stitek():
    """Stitek pod listou panelu pN: 1. radek co panel ukazuje (soubor / adresar) a vpravo
    [copy], ktere tu cestu da do schranky; 2. radek cim to jede. Ke kteremu panelu patri,
    pozna podle sve polohy. Po zmene kodu skonci a smycka ho pusti znovu."""
    import termios
    code = os.path.getmtime(ME)
    me = os.environ.get("TMUX_PANE", "")
    fd = sys.stdin.fileno()
    try:
        old = termios.tcgetattr(fd)
        new = termios.tcgetattr(fd)
        new[3] &= ~(termios.ECHO | termios.ICANON)
        termios.tcsetattr(fd, termios.TCSANOW, new)
    except termios.error:
        old = None
    out = sys.stdout
    out.write("\x1b[?25l\x1b[?7l\x1b[?1000h\x1b[?1006h")
    BG, FG = "\x1b[48;5;235m", "\x1b[22;38;5;250m"
    shown, buttons = None, []
    shows, asked = "", (0.0, "")       # ptat se programu nejvys jednou za 2 s
    try:
        while os.path.getmtime(ME) == code:
            L = lay()
            n = next((s for s, b in L["st"].items() if b and b["id"] == me), 0)
            p = panel(L, n) if n else None
            if p and (time.time() - asked[0] > 2 or asked[1] != p["id"]):
                shows, asked = panel_shows(p), (time.time(), p["id"])
            app = panel_app(p)
            opts = switch_options(p, shows)
            size = shutil.get_terminal_size((80, STITEK_H))
            state = (size, n, shows, app, tuple((o[0], o[2]) for o in opts))
            if state != shown:
                buttons = []
                path = shows if shows and shows != "pindání" else ""
                cp = "[copy]" if path else ""
                # [copy] hned za cestou; dlouha cesta se zkrati, at se vejde
                txt = cut(" " + short(path), max(0, size.columns - len(cp) - 1)) if path else ""
                row1 = "\x1b[38;5;252m%s%s" % (txt, FG)
                if cp:
                    xc = cwidth(txt) + 2
                    buttons.append((1, xc, xc + len(cp) - 1, ["--toggle", "copy%d" % n]))
                    row1 += " \x1b[38;5;110m%s%s" % (cp, FG)
                row2 = "\x1b[38;5;244m %s%s" % (app, FG) if app else ""
                # vpravo prepinac: interni [x] v panelu, externi ↗x v okne; aktivni oranzove
                sw = "  ".join(o[0] for o in opts)
                if opts and cwidth(app) + 4 + cwidth(sw) >= size.columns:
                    row2, app = "", ""                   # uzky panel: jmeno appky ustoupi prepinaci
                if opts and cwidth(app) + (4 if app else 1) + cwidth(sw) < size.columns:
                    x = size.columns - cwidth(sw)
                    row2 += " " * max(1, x - 1 - cwidth(" " + app)) if app else " " * (x - 1)
                    for label, internal, active, args_ in opts:
                        buttons.append((2, x, x + cwidth(label) - 1, ["--switch", "p%d" % n] + args_))
                        row2 += "\x1b[38;5;%dm%s%s%s  " % (214 if active else 110 if internal else 151,
                                                           "\x1b[1m" if active else "", label, FG)
                        x += cwidth(label) + 2
                rows = ([row1, row2] + [""] * size.lines)[:size.lines]
                out.write("".join("\x1b[%d;1H%s%s%s\x1b[K" % (i + 1, BG, FG, r)
                                  for i, r in enumerate(rows)) + "\x1b[0m")
                out.flush()
                shown = state
            r, _, _ = select.select([fd], [], [], 0.5)
            if not r:
                continue
            data = os.read(fd, 1024)
            for m in RE_SGR.finditer(data):
                b, mx, my = int(m.group(1)), int(m.group(2)), int(m.group(3))
                if b != 0 or m.group(4) != b"M":
                    continue
                hit = next((a for y, x0, x1, a in buttons if y == my and x0 <= mx <= x1), None)
                if hit:
                    subprocess.Popen([ME] + hit, stdin=subprocess.DEVNULL,
                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                     start_new_session=True)
    finally:
        out.write("\x1b[?1000l\x1b[?1006l\x1b[?7h\x1b[?25h")
        out.flush()
        if old:
            termios.tcsetattr(fd, termios.TCSANOW, old)


def copy_path(p):
