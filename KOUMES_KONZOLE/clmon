def view_cmd(path, line=0):
    if (path or "").startswith(ESENCE):
        return "%s %s" % (shlex.quote(ESENCE_APP), shlex.quote(path[len(ESENCE):]))
    if path and os.path.isdir(path):
        return "%s %s" % (shlex.quote(GIT_LIST), shlex.quote(path))
    if path == REPOS:
        return shlex.quote(REPOS_APP)
