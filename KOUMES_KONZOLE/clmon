def menu():
    """Menu nad seznamem: [close] [config] tlacitka koumesu [p1] [p3] [p2], vpravo hlaska.
    Otevrene panely jsou oranzove (klik do panelu skoci), posledni sedy je dalsi volny
    (klik ho otevre). Pindani je v liste nad panelem.
    Klik si cte samo; akci pusti jako samostatny prikaz, at se menu mezitim nezasekne.
    Po zmene kodu skonci a smycka ho pusti znovu."""
    import termios
    code = os.path.getmtime(ME)
    fd = sys.stdin.fileno()
    try:
        old = termios.tcgetattr(fd)
        new = termios.tcgetattr(fd)
        new[3] &= ~(termios.ECHO | termios.ICANON)
        termios.tcsetattr(fd, termios.TCSANOW, new)
    except termios.error:
        old = None
    out = sys.stdout
    # bez zalamovani: dlouhy radek by panel odroloval a tlacitka by zmizela nahoru
    out.write("\x1b[?25l\x1b[?7l\x1b[?1000h\x1b[?1006h")
    BG, FG = "\x1b[48;5;235m", "\x1b[22;38;5;250m"
    ranges = []                  # (radek, od, do, akce) - sloupce od 1 jako v udalosti mysi
    shown = None
    cfg = None
    buf = b""

    def seg(row, x, text, color, bold=False, name=None):
        w = cwidth(text)
        if name:
            ranges.append((row, x, x + w - 1, name))
        return x + w, "%s\x1b[38;5;%dm%s%s%s" % ("\x1b[1m" if bold else "", color, text, FG, BG)

    def draw(size, opened, chat, msg, _idle="", busy="", live=()):
        ranges.clear()
        x, s = 2, " "
        used = {int(n) for n in opened.split(",") if n.isdigit()}
        nxt = next((n for n in range(1, PANEL_MAX + 1) if n not in used), 0)
        # [close] az kdyz nic nebezi; do te doby misto nej konec zobrazeneho agenta
        buttons = [("close", "[close]") if not busy else ("exit_actual", "[exit actual]"), ("config", "[config]")] \
            + [(n, "[%s]" % n) for n in KOUMES_ROOTS] + [("dir", "[dir]")] \
            + ([("diag", "[diag]")] if DIAG_SCRIPT else []) + [("chat", "[pindání]")]
        # otevrene panely oranzove (klik = skocit do nej), za nimi dalsi volny sede (klik = otevrit)
        for n in sorted(used):
            buttons.append(("p%d" % n, "[p%d]" % n))
        if nxt:
            buttons.append(("p%d" % nxt, "[p%d]" % nxt))
        row, row1, x1 = 1, None, x
        for name, text in buttons:
            if name == "dir":
                # od [dir] druhy radek: prvni radek zustava koumesum a [close]
                row1, x1, s, x, row = s, x, " ", 2, 2
            # zlute = ta appka uz bezi; klik ji pak nepousti znovu, jen ji srovna vedle terminalu
            opened = (name[1:].isdigit() and int(name[1:]) in used) or (name == "chat" and chat)
            color = (174 if name in ("close", "exit_actual") else 226 if name in live
                     else 214 if opened else 246)
            x, part = seg(row, x, text, color, opened, name)
            s += part + "  "
            x += 2
        row2 = s if row1 is not None else ""
        if row1 is None:
            row1, x1 = s, x
        x = x1
        # vpravo jen hlaska, kdyz clmon4 neco hlasi; nebezici agenti jsou v seznamu pod menu
        right = (" %s " % msg) if msg else ""
        rw = cwidth(right)
        if right and x + rw < size.columns:
            row1 += " " * (size.columns - rw - x) + "\x1b[48;5;220m\x1b[38;5;16m%s%s%s" % (right, FG, BG)
        rows = [row1, row2] + [""] * max(0, size.lines - 2)
        out.write("".join("\x1b[%d;1H%s%s\x1b[K%s" % (r + 1, BG, FG, text)
                          for r, text in enumerate(rows[:size.lines])) + "\x1b[0m")
        out.flush()

    try:
        while os.path.getmtime(ME) == code:
            rc, st = tmux("display-message", "-p", "#{@panels}%s#{@chat}%s#{@msg}%s#{@idle}%s#{@busy}"
                         % (SEP, SEP, SEP, SEP))
            parts = (st.split(SEP) + [""] * 5)[:5]
            cfg = use_config(cfg)              # zmena config.t2l: tlacitka bez restartu
            size = shutil.get_terminal_size((80, TBAR_H))
            live = koumes_live()
            state = (size, tuple(parts), live, tuple(KOUMES_ROOTS), DIAG_SCRIPT)
            if state != shown:
                draw(size, *parts, live=live)
                shown = state
            r, _, _ = select.select([fd], [], [], 0.3)
            if not r:
                continue
            buf += os.read(fd, 1024)
            for m in RE_SGR.finditer(buf):
                b, mx, my, kind = int(m.group(1)), int(m.group(2)), int(m.group(3)), m.group(4)
                if b != 0 or kind != b"M":
                    continue                        # jen stisk leveho tlacitka
                hit = next((name for row, x0, x1, name in ranges if row == my and x0 <= mx <= x1), None)
                if hit:
                    cmd = [ME, "--close"] if hit == "close" else [ME, "--toggle", hit]
                    subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                     stderr=subprocess.DEVNULL, start_new_session=True)
            buf = b""
    finally:
        out.write("\x1b[?1000l\x1b[?1006l\x1b[?7h\x1b[?25h")
        out.flush()
        if old:
            termios.tcsetattr(fd, termios.TCSANOW, old)


def open_panel(n, role, cmd, path=None, run=None):
    """Dat do panelu pN prohlizec textu (view), editor (edit) nebo pindani (chat);
    panel se otevre, kdyz neni. n = 0 znamena novy panel s nejnizsim volnym cislem.
    Vraci (chyba, cislo panelu)."""
    L = lay()
    if not L["list"]:
        return "seznam nebezi", 0
    if not n:
        n = free_slot(L)
        if not n:
            return "víc panelů než p%d nejde" % PANEL_MAX, 0
    if not leave_editor(n, L):
        return EDIT_BUSY % n, n
    L = lay()
    p = panel(L, n)
    old = None                                    # sirky sloupcu pred novym panelem
    if p:
        pid = p["id"]
        popt(pid, "@title", "")
        tmux("respawn-pane", "-k", "-t", pid, cmd)
    else:
        old = [c["w"] for k, c in columns(L)]
        busy(True)
        pid = add_panel(role, want_w(n), HOME, cmd)
        if not pid:
            busy(False)
            return "nejde otevřít p%d" % n, n
    popt(pid, "@slot", str(n))
    popt(pid, "@role", role)
    if path is not None:
        popt(pid, "@file", path)
    if run is None and role in ("view", "edit", "hx"):
        run = ""                                  # soubor misto programu - program zapomenout
    if run is not None:
        popt(pid, "@run", run)
    if role != "run":
        popt(pid, "@port", "")                    # program skoncil, port uz neni jeho
    if role == "run":
        popt(pid, "@title", run)
    if role == "chat":
        popt(pid, "@title", "pindání")
    if old is not None:
        # novy panel je vpravo s vychozi sirkou, ostatni zustanou, jak byly
        fit(old + [want_w(n)], right=True)
        busy(False)
    ensure_tbars()
    return None, n


def close_panel(n):
    if not leave_editor(n):
        return EDIT_BUSY % n
    p = panel(lay(), n)
    if p:
        drop_panel(p)
    return None


EDIT_BUSY = "editor má neuložené změny - odpověz mu v p%d: y uložit, n zahodit, Esc zůstat"


def leave_editor(n, L=None):
    """Slusne ukoncit editor v panelu pN: posle mu Ctrl+Q. Kdyz ma vse ulozene, skonci
    a v panelu nabehne prohlizec - vraci True. Kdyz se pta na ulozeni, necha ho byt, da mu
    vstup a vraci False. True vraci i tehdy, kdyz v panelu zadny editor nebezi."""
    p = panel(L or lay(), n)
    if not p or p["role"] not in ("edit", "hx"):
        return True
    if p["role"] == "hx":
        # helix: :q s neulozenymi zmenami odmitne a zustane bezet
        tmux("send-keys", "-t", p["id"], "Escape")
        tmux("send-keys", "-t", p["id"], "-l", ":q")
        tmux("send-keys", "-t", p["id"], "Enter")
    else:
        tmux("send-keys", "-t", p["id"], "C-q")
    for _ in range(25):
        time.sleep(0.1)
        q = panel(lay(), n)
        if not q or q["role"] not in ("edit", "hx"):
            return True
    tmux("select-pane", "-t", p["id"])
    return False


def edit_cmd(path, line=0):
    """Editor v panelu. Po jeho zavreni se panel vrati do prohlizece a ukaze ulozenou verzi."""
    q = shlex.quote(path)
    plus = " +%d" % line if line > 0 else ""
    try:
        os.makedirs(MICRO_DIR, exist_ok=True)
        bf = os.path.join(MICRO_DIR, "bindings.json")
        # micro si soubor doplnuje o vlastni zkratky - prepsat jen kdyz v nem Alt+C chybi
        if not os.path.exists(bf) or '"Alt-c"' not in open(bf, encoding="utf-8").read():
            with open(bf, "w", encoding="utf-8") as fh:
                fh.write(MICRO_BINDINGS)
        conf = " -config-dir %s" % shlex.quote(MICRO_DIR)
    except OSError:
        conf = ""
    return "%s%s%s %s; exec %s" % (EDITOR, conf, plus, q, view_cmd(path))


def hx_cmd(path, line=0):
    """Helix v panelu; po :q se panel vrati do prohlizece."""
    q = shlex.quote(path + (":%d" % line if line > 0 else ""))
    return "%s %s; exec %s" % (HX, q, view_cmd(path))


