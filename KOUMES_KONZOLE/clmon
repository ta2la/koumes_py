            res.append({"id": p[0], "win": p[1], "role": p[2], "agent": p[3],
                        "h": int(p[4] or 0), "wh": int(p[5] or 0), "zoom": p[6] == "1",
                        "w": int(p[7] or 0), "ww": int(p[8] or 0), "cmd": p[9],
                        "x": int(p[10] or 0), "slot": int(p[11]) if p[11].isdigit() else 0,
                        "file": p[12], "run": p[13], "lock": p[14] == "1",
                        "port": int(p[15]) if p[15].isdigit() else 0})
    return res


def lay(ps=None):
    """Co je v hlavnim okne: list = seznam, main = terminal agenta, panels = panely pN
    zleva doprava (kazdy ma "slot" = N). tb = lista nastroju nad panelem podle cisla;
    k panelu patri ta, ktera s nim zacina na stejnem sloupci obrazovky. tbars = vsechny listy.
    st / stitky = totez pro stitky pod listou."""
    ps = panes() if ps is None else ps
    out = {"list": None, "main": None, "panels": [], "menu": None, "tb": {}, "tbars": [],
           "st": {}, "stitky": [], "avatar": None}
    lp = next((p for p in ps if p["role"] == "list"), None)
    if not lp:
        return out
    out["list"] = lp
    for p in ps:
        if p["win"] != lp["win"] or p["id"] == lp["id"]:
            continue
        if p["role"] in PANEL_ROLES and p["slot"]:
            out["panels"].append(p)
        elif p["role"] == "tbar":
            out["tbars"].append(p)
        elif p["role"] == "stitek":
            out["stitky"].append(p)
        elif p["role"] == "menu":
            out["menu"] = p
        elif p["role"] == "avatar":
            out["avatar"] = p
        elif p["agent"] and not out["main"]:
            out["main"] = p
    out["panels"].sort(key=lambda p: p["x"])
    for p in out["panels"]:
        out["tb"][p["slot"]] = next((b for b in out["tbars"] if b["x"] == p["x"]), None)
        out["st"][p["slot"]] = next((b for b in out["stitky"] if b["x"] == p["x"]), None)
    return out


