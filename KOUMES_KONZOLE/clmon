    fields = ["#{pane_id}", "#{window_id}", "#{@role}", "#{@agent}", "#{pane_height}",
              "#{window_height}", "#{window_zoomed_flag}", "#{pane_width}", "#{window_width}",
              "#{pane_current_command}", "#{pane_left}", "#{@slot}", "#{@file}", "#{@run}", "#{@lock}", "#{@port}"]
    rc, out = tmux("list-panes", "-a", "-F", SEP.join(fields))
    res = []
    if rc != 0:
        return res
    for line in out.splitlines():
        p = line.split(SEP)
