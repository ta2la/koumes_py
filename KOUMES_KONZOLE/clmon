def bind_keys(list_pane=""):
    """Klavesy a mys. F12 + klavesa vzdy, Alt + klavesa kdyz ji terminal pusti."""
    q = shlex.quote(ME)
    lines = [KEYS.replace("ME", q).replace("LISTPANE", list_pane or "ui:0.0")]
    for n in range(10):
        lines.append('bind %d run -b "%s --number %d"' % (n, q, n))
        lines.append('bind -n M-%d run -b "%s --number %d"' % (n, q, n))
    for key, arg in (("Up", "--focus-list"), ("Down", "--focus-agent"), ("z", "--zoom"),
                     ("p", "--toggle pnext")):
        lines.append('bind %s run -b "%s %s"' % (key, q, arg))
        lines.append('bind -n M-%s run -b "%s %s"' % (key, q, arg))
    with open(KEYS_CONF, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")
    rc, _ = tmux("source-file", KEYS_CONF)
    return rc == 0


# ---- spolecne pro curses casti -----------------------------------------------------------
class Ui:
    def __init__(self, scr):
        self.scr = scr
        curses.curs_set(0)
        curses.use_default_colors()
        self.pal = {}
        if curses.has_colors():
            for i, c in enumerate([curses.COLOR_GREEN, curses.COLOR_YELLOW, curses.COLOR_CYAN,
                                   curses.COLOR_RED, curses.COLOR_BLUE, curses.COLOR_MAGENTA], 1):
                curses.init_pair(i, c, -1)
            self.pal = {"busy": curses.color_pair(1) | curses.A_BOLD,
                        "active": curses.color_pair(2) | curses.A_BOLD,
                        "info": curses.color_pair(3), "warn": curses.color_pair(4),
                        "dir": curses.color_pair(5) | curses.A_BOLD,
                        "key": curses.color_pair(3), "head": curses.color_pair(6) | curses.A_BOLD,
                        "code": curses.color_pair(1)}
            curses.init_pair(30, curses.COLOR_BLACK, curses.COLOR_YELLOW)
            self.pal["arm"] = curses.color_pair(30)          # cerne na zlutem
            # Zakladni zluta je v gnome-terminalu hneda. Pro kontext opravdova zluta
            # z 256 barev, a cervena k ni taky jasna.
            big = curses.COLORS >= 256
            curses.init_pair(31, 226 if big else curses.COLOR_YELLOW, -1)
            curses.init_pair(32, 196 if big else curses.COLOR_RED, -1)
            self.pal["ctx_warn"] = curses.color_pair(31)
            # agent na jinem PC: tmave oranzova
            curses.init_pair(35, 166 if big else curses.COLOR_YELLOW, -1)
            self.pal["remote"] = curses.color_pair(35)
            self.pal["ctx_high"] = curses.color_pair(32) | curses.A_BOLD
            # stav agenta: waiting = ceka na uzivatele (podkres cervene, blika), busy = cerveny text
            curses.init_pair(33, curses.COLOR_WHITE, 196 if big else curses.COLOR_RED)
            self.pal["st_wait"] = curses.color_pair(33) | curses.A_BOLD | curses.A_BLINK
            self.pal["st_busy"] = curses.color_pair(32) | curses.A_BOLD
            # aktivni agent v seznamu: cerne na 214 jako stitek agenta v ramecku panelu (tab)
            curses.init_pair(34, 16 if big else curses.COLOR_BLACK, 214 if big else curses.COLOR_YELLOW)
            self.pal["tab"] = curses.color_pair(34) | curses.A_BOLD
        # Mys se v curses necte: pri tazeni ceka na zbytek udalosti a program zamrzne.
        # Kliky resi tmux (bind_keys), sem chodi jen klavesy.
        scr.timeout(1000)
        self.pane = os.environ.get("TMUX_PANE", "")

    def put(self, y, x, s, attr=0):
        h, w = self.scr.getmaxyx()
        if y < 0 or y >= h or x >= w - 1:
            return x
        s = cut(s, w - 1 - x)
        try:
            self.scr.addstr(y, x, s, attr)
        except curses.error:
            pass
        return x + cwidth(s)

    def title(self, text):
        if self.pane:
            popt(self.pane, "@title", text)

    @staticmethod
    def close(name):
        """Zavrit vlastni panel. Dela to tmux zvenci: kdyby si panel zavrel sam sebe,
        skoncil by driv, nez se okno stihne zuzit."""
        tmux("run-shell", "-b", "%s --toggle %s" % (shlex.quote(ME), name))


# ---- seznam agentu (nahore) ----------------------------------------------------------------
# Avatar aktivniho agenta: samostatny panel vlevo vedle seznamu, stejne vysoky. Obrazek je na
# sirku panelu a co se pod seznam nevejde, je urizle. Jeden PNG na personu,
# jmeno = jmeno persony (KAREL.png); workeri T1-T6 maji WORKERS.png, odkladiste T TEMP.png,
# kdyz dole nikdo neni, je tam PARTA.png. Vyrezy z plakatu jsou 220x318.
AVATAR_DIR = ""       # plni use_config
AVATAR_W = 32                          # sirka panelu s avatarem


def avatar_path(label):
    name = label.split()[-1].upper() if label else "PARTA"
    if re.fullmatch(r"T\d", name):
        name = "WORKERS"
    elif name == "T":
        name = "TEMP"
    path = os.path.join(AVATAR_DIR, name + ".png")
    return path if AVATAR_DIR and os.path.isfile(path) else None


def ensure_avatar(L):
    """Panel s avatarem vlevo vedle seznamu (deli radek seznamu, okno se nemeni).
    Stary sloupec pres celou vysku okna zrusi a okno o nej zuzi."""
    lp, av = L["list"], L["avatar"]
    if not lp or lp["zoom"]:
        return False
    if av and av["h"] == lp["h"]:
        if av["w"] != AVATAR_W:               # sirku drzet (tmux ji pri deleni zaokrouhli)
            touch()
            tmux("resize-pane", "-t", av["id"], "-x", AVATAR_W)
            touch()
        return False
    touch()
    if av:                                    # puvodni sloupec pres celou vysku
        tmux("kill-pane", "-t", av["id"])
        grow(-(av["w"] + 1))
    rc, pid = tmux("split-window", "-d", "-h", "-b", "-l", AVATAR_W, "-t", lp["id"],
                   "-c", HOME, "-P", "-F", "#{pane_id}",
                   "while :; do %s --avatar; sleep 1; done" % shlex.quote(ME))
    if rc == 0 and pid:
        popt(pid, "@role", "avatar")
    touch()
    return True


def avatar():
    """Panel s avatarem: obrazek agenta, ktery je dole, na sirku panelu; spodek, ktery se
    nevejde, je urizly.
    Prekresli se pri zmene agenta, velikosti nebo souboru; po zmene kodu skonci."""
    code = os.path.getmtime(ME)
    out = sys.stdout.fileno()
    os.write(out, b"\x1b[?25l")
    shown = None
    while os.path.getmtime(ME) == code:
        main = lay()["main"]
        path = avatar_path(main["agent"] if main and main["role"] != "idle" else "")
        w, h = shutil.get_terminal_size((AVATAR_W, 24))
        key = (path, path and os.path.getmtime(path), w, h)
        if key != shown:
            shown = key
            lines = (chafa_lines(path, w, 999, fine=True) or [])[:h] if path else None
            os.write(out, ("\x1b[H\x1b[2J" + "".join("\x1b[%d;1H%s" % (i + 1, l)
                     for i, l in enumerate(lines or []))).encode("utf-8", "replace"))
        time.sleep(0.5)


