            ts = float(ra)
        except (TypeError, ValueError):
            try:
                ts = datetime.datetime.fromisoformat(str(ra).replace("Z", "+00:00")).timestamp()
            except ValueError:
                ts = 0
        if ts and ts < now:
            out.append(("%s ? (okno skončilo)" % name, None))
            continue
        lt = time.localtime(ts) if ts else None
        when = ("" if not lt else time.strftime("%H:%M", lt) if ts - now < 86400
                else "%s %s" % (DNY[lt.tm_wday], time.strftime("%H:%M", lt)))
        out.append(("%s %d%%%s" % (name, round(pct), " (do %s)" % when if when else ""), pct))
    return out


def codex_limits():
    """Limity uctu Codexu (GPT) z posledniho token_count v nejnovejsim prepisu Codexu:
    [(text, procenta)] jako usage_parts; prazdne, kdyz Codex nebezel. Codex je zapise
    jen pri tahu - okno, ktere mezitim skoncilo, je 0 %."""
    files = sorted(glob.glob(os.path.join(CODEX_SESS, "*", "*", "*", "*.jsonl")),
                   key=os.path.getmtime, reverse=True)
    rl = {}
    for f in files[:5]:
        try:
            with open(f, "rb") as fh:
                fh.seek(max(0, os.path.getsize(f) - 400000))
                lines = fh.read().decode("utf-8", "replace").splitlines()
        except OSError:
            continue
        for line in reversed(lines):
            if '"rate_limits"' in line:
                try:
                    rl = json.loads(line)["payload"].get("rate_limits") or {}
                except (ValueError, KeyError, AttributeError):
                    rl = {}
                if rl:
                    break
        if rl:
            break
    out, now = [], time.time()
    for key, name in (("primary", "5h"), ("secondary", "týden")):
        w = rl.get(key) or {}
        pct, ts = w.get("used_percent"), w.get("resets_at") or 0
        if pct is None:
            continue
        if ts and ts < now:
            out.append(("%s 0%%" % name, 0))
            continue
        lt = time.localtime(ts) if ts else None
        when = ("" if not lt else time.strftime("%H:%M", lt) if ts - now < 86400
                else "%s %s" % (DNY[lt.tm_wday], time.strftime("%H:%M", lt)))
        out.append(("%s %d%%%s" % (name, round(pct), " (do %s)" % when if when else ""), pct))
    return out


def row_to_idx(y):
    """Radek v seznamu (kde jsou jen bezici) -> cislo persony; -1, kdyz tam nic neni."""
    vis = running(rows_state())
    return vis[y][0] if 0 <= y < len(vis) else -1


def idle_layout(rows, width):
    """Nebezici pro seznam: persony, oddelovac, workeri, zalomene na sirku seznamu.
    Vraci radky, kazdy jako [(sloupec, text, cislo polozky nebo None)]."""
    st = stopped(rows)
    pers = [(i, "%d %s" % (i + 1, label), 4) for i, label, path, _, _ in st if not is_worker(path)]
    work = [(i, "[%s]" % label.split()[-1], 3) for i, label, path, _, _ in st if is_worker(path)]
    seq = pers + ([(None, "┊", 3)] if pers and work else []) + work
    out, row, x = [], [], 2
    for i, text, gap in seq:
        w = cwidth(text)
        if row and x + w >= width:
            out.append(row)
            row, x = [], 2
        row.append((x, text, i))
        x += w + gap
    if row:
        out.append(row)
    return out


def idle_data(rows):
    """Nebezici persony a workeri pro menu nad seznamem: `cislo,worker,visacka` oddelene ¦.
    Drzi to volba tmuxu @idle, menu si ji cte."""
    return "¦".join("%d,%d,%s" % (i, is_worker(path), label)
                    for i, label, path, _, _ in stopped(rows))


def idle_bar(rows):
    """Druhy radek horni listy: nebezici persony jako klikaci jmena. Prazdny, kdyz bezi vsichni."""
    st = stopped(rows)
    if not st:
        return ""
    pers = ["#[range=user|a%d]%d %s#[norange]" % (i, i + 1, label)
            for i, label, path, _, _ in st if not is_worker(path)]
    # workeri jen jako tlacitko se jmenem, bez ikony s cislem
    work = ["#[range=user|a%d][%s]#[norange]" % (i, label.split()[-1])
            for i, label, path, _, _ in st if is_worker(path)]
    out = " " + "    ".join(pers)
    if work:
        out += ("   #[fg=colour244]┊#[default]   " if pers else "") + "   ".join(work)
    return out


def wake(pane_id):
