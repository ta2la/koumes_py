CODEX_SESS = os.path.expanduser("~/.codex/sessions")


def codex_transcript(path):
    """Nejnovejsi prepis Codexu pro adresar (cwd je v prvnim radku, session_meta), nebo ''."""
    files = sorted(glob.glob(os.path.join(CODEX_SESS, "*", "*", "*", "*.jsonl")),
                   key=os.path.getmtime, reverse=True)
    for f in files[:30]:
        try:
            with open(f, encoding="utf-8") as fh:
                meta = json.loads(fh.readline()).get("payload") or {}
        except (OSError, ValueError):
            continue
        if meta.get("cwd", "").rstrip("/") == path.rstrip("/"):
            return f
    return ""


def codex_usage(f):
    """(kontext, model) z konce prepisu Codexu: posledni token_count a turn_context."""
    ctx, model = 0, ""
    try:
        with open(f, "rb") as fh:
            fh.seek(max(0, os.path.getsize(f) - 400000))
            lines = fh.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return ctx, model
    for line in reversed(lines):
        if ctx and model:
            break
        if not ctx and '"token_count"' in line:
            try:
                info = json.loads(line)["payload"].get("info") or {}
                ctx = (info.get("last_token_usage") or {}).get("total_tokens", 0)
            except (ValueError, KeyError, AttributeError):
                pass
        if not model:
            m = re.search(r'"model":"([^"]+)"', line)
            if m:
                model = m.group(1)
    return ctx, model


def codex_status(f):
    """(stav, od kdy) z konce prepisu Codexu: busy po task_started, idle po task_complete
    nebo prerusenem tahu. Bez prepisu idle."""
    try:
        with open(f, "rb") as fh:
            fh.seek(max(0, os.path.getsize(f) - 400000))
            lines = fh.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return "idle", time.time()
    for line in reversed(lines):
        m = re.search(r'"payload":\{"type":"(task_started|task_complete|turn_aborted)"', line)
        if m:
            try:
                since = ts_of(json.loads(line))
            except ValueError:
                since = 0
            return ("busy" if m.group(1) == "task_started" else "idle"), since or time.time()
    return "idle", os.path.getmtime(f)


def pane_busy(pane_id):
    """Ma shell v panelu podproces (bezi v nem neco, nejen prompt)?"""
    pid = tmux("display", "-p", "-t", pane_id, "#{pane_pid}")[1].strip()
    try:
        return bool(open("/proc/%s/task/%s/children" % (pid, pid)).read().strip())
    except OSError:
        return False


def state_of(label, path, ps, agents):
    """here = bezi tady · jinde = bezi mimo clmon4 · shell = panel bez session · off"""
    sess = next((a for a in agents if a["cwd"].rstrip("/") == path.rstrip("/")), None)
    if sess:
        return ("here" if in_our_tmux(sess["pid"]) else "jinde"), sess
    pane = pane_of(label, ps)
    if pane and conf_cmd(path) and pane_busy(pane["id"]):
        # agent z `cmd:` (napr. codex) nema session soubor claude - bezi, kdyz shell
        # v jeho panelu ma podproces (pane_current_command nestaci: u `bash -c "x; exec
        # bash"` je codex v process group bashe a tmux hlasi bash)
        tr = codex_transcript(path)
        status, since = codex_status(tr) if tr else ("idle", time.time())
        return "here", {"pid": 0, "cwd": path, "status": status, "since": since,
                        "transcript": tr, "codex": True}
    if os.environ.get("CLMON4_FAKE_HERE") and pane_of(label, ps):
        # jen pro zkouseni nanecisto: panel s nahradnim prikazem se tvari jako bezici agent
        return "here", {"pid": 0, "cwd": path, "status": "idle", "since": time.time(),
                        "transcript": ""}
    return ("shell" if pane_of(label, ps) else "off"), None


